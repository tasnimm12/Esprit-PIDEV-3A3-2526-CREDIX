<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Claim Created</title>
</head>
<body style="font-family: Arial, sans-serif; background: #f6f8fb; margin: 0; padding: 24px;">
    <div style="max-width: 720px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb;">
        <div style="background: #0d6efd; color: #ffffff; padding: 24px;">
            <h1 style="margin: 0; font-size: 24px;">New Claim Created</h1>
            <p style="margin: 8px 0 0 0;">Claim #{{ claimNumber }} requires admin attention.</p>
        </div>

        <div style="padding: 24px;">
            <p style="margin-top: 0;">A new insurance claim has just been submitted in the system.</p>

            <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb; width: 35%;"><strong>Claim ID</strong></td>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;">#{{ claimNumber }}</td>
                </tr>
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;"><strong>Client</strong></td>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;">{{ claimOwner.prenom }} {{ claimOwner.nom }}</td>
                </tr>
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;"><strong>Email</strong></td>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;">{{ claimOwner.email }}</td>
                </tr>
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;"><strong>Contract</strong></td>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;">{{ contract.numeroContrat }}</td>
                </tr>
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;"><strong>Insurance Type</strong></td>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;">{{ insuranceType ?: 'N/A' }}</td>
                </tr>
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;"><strong>Incident Date</strong></td>
                    <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;">{{ sinistre.dateSinistre|date('Y-m-d') }}</td>
                </tr>
                <tr>
                    <td style="padding: 10px; vertical-align: top;"><strong>Description</strong></td>
                    <td style="padding: 10px; white-space: pre-wrap;">{{ sinistre.description }}</td>
                </tr>
            </table>

            <p style="margin-bottom: 0;">Please review the claim from the admin dashboard when convenient.</p>
        </div>
    </div>
</body>
</html>
