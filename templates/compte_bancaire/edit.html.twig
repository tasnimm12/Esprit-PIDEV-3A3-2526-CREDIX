{% extends 'base.html.twig' %}

{% block title %}Modifier le Compte Bancaire{% endblock %}

{% block content %}
<div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
    <div class="container">
        <div class="row mb-4">
            <div class="col-md-8 mx-auto">
                <h2 class="mb-1">
                    <i class="fa fa-edit me-2"></i>Modifier le Compte Bancaire
                </h2>
                <p class="text-muted">{{ compte.getTypeCompte }}</p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8 mx-auto">
                {% include '_partials/validation_errors.html.twig' %}

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <form method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Numéro de Compte</label>
                                <input type="text" class="form-control" value="{{ compte.getNumeroCompte }}" disabled>
                                <small class="text-muted d-block mt-1">Le numéro de compte ne peut pas être modifié</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Type de Compte <span class="text-danger">*</span></label>
                                <select name="type_compte" class="form-select">
                                    <option value="Courant" {% if compte.getTypeCompte == 'Courant' %}selected{% endif %}>Compte Courant</option>
                                    <option value="Épargne" {% if compte.getTypeCompte == 'Épargne' %}selected{% endif %}>Compte d'Épargne</option>
                                    <option value="Titre" {% if compte.getTypeCompte == 'Titre' %}selected{% endif %}>Compte-Titre</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Titulaire du Compte <span class="text-danger">*</span></label>
                                <input type="text" name="titulaire" class="form-control" value="{{ compte.getTitulaire }}">
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Devise <span class="text-danger">*</span></label>
                                <select name="devise" class="form-select">
                                    <option value="USD" {% if compte.getDevise == 'USD' %}selected{% endif %}>USD ($)</option>
                                    <option value="EUR" {% if compte.getDevise == 'EUR' %}selected{% endif %}>EUR (€)</option>
                                    <option value="GBP" {% if compte.getDevise == 'GBP' %}selected{% endif %}>GBP (£)</option>
                                    <option value="TND" {% if compte.getDevise == 'TND' %}selected{% endif %}>TND (د.ت)</option>
                                </select>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Email</label>
                                    <input type="email" name="email" class="form-control" value="{{ compte.getEmail }}" placeholder="email@example.com">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Téléphone</label>
                                    <input type="tel" name="telephone" class="form-control" value="{{ compte.getTelephone }}" placeholder="+216 XX XXX XXX">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Solde</label>
                                <div class="input-group">
                                    <input type="number" name="solde" class="form-control" value="{{ compte.getSolde }}">
                                    <span class="input-group-text">{{ compte.getDevise }}</span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="form-check form-switch">
                                    <input type="checkbox" name="actif" class="form-check-input" id="actif" value="1" {% if compte.getActif %}checked{% endif %}>
                                    <label class="form-check-label" for="actif">Compte Actif</label>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fa fa-save me-2"></i>Mettre à Jour
                                </button>
                            </div>
                        </form>

                        <div class="mt-3">
                            <a href="{{ path('app_compte_bancaire_show', {id: compte.getId}) }}" class="btn btn-outline-secondary w-100">
                                <i class="fa fa-times me-2"></i>Annuler
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
