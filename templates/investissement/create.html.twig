{% extends 'base.html.twig' %}

{% block title %}Invest in {{ projet.getNomprojet() }}{% endblock %}

{% block content %}
<div class="container mt-5 pt-5 pb-5">
    <div class="row mb-4">
        <div class="col-md-8 mx-auto">
            <h1>Invest in {{ projet.getNomprojet() }}</h1>
        </div>
    </div>

    {% if app.flashes %}
        <div class="row mb-4">
            <div class="col-md-8 mx-auto">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                            {% if type == 'error' %}<i class="fas fa-exclamation-circle me-2"></i>{% else %}<i class="fas fa-check-circle me-2"></i>{% endif %}
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# PHP Server-Side Validation Errors #}
    {% if errors is defined and errors|length > 0 %}
        <div class="row mb-4">
            <div class="col-md-8 mx-auto">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> <strong>Please fix the following errors:</strong>
                    <ul class="mb-0 mt-2">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0">Project Details</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-6 pb-3">
                            <small class="text-muted d-block mb-2">Target Amount</small>
                            <p class="h5 mb-0">{{ projet.getMontantObjectif()|number_format(2, '.', ',') }} D.T</p>
                        </div>
                        <div class="col-md-6 pb-3">
                            <small class="text-muted d-block mb-2">Sector</small>
                            <p class="h5 mb-0">{{ projet.getSecteur() ?? 'N/A' }}</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 pb-3">
                            <small class="text-muted d-block mb-2">Start Date</small>
                            <p class="mb-0">{{ projet.getDateDebut()|date('d/m/Y') }}</p>
                        </div>
                        <div class="col-md-6 pb-3">
                            <small class="text-muted d-block mb-2">End Date</small>
                            <p class="mb-0">{{ projet.getDateFin()|date('d/m/Y') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0">Investment Details</h5>
                </div>
                <div class="card-body p-4">
                    <form method="POST">
                        <div class="mb-4">
                            <label for="montant_investi" class="form-label fw-semibold">Investment Amount (D.T) *</label>
                            <input type="number" class="form-control form-control-lg" id="montant_investi" name="montant_investi" placeholder="Enter amount">
                            <small class="text-muted d-block mt-2">Minimum investment amount required</small>
                        </div>

                        <div class="mb-4">
                            <label for="compte_id" class="form-label fw-semibold">Bank Account *</label>
                            <select class="form-control form-control-lg" id="compte_id" name="compte_id">
                                <option value="">-- Select an account --</option>
                                {% for compte in bankAccounts %}
                                <option value="{{ compte.getId() }}">
                                    {{ compte.getNumeroCompte() }} - Balance: {{ compte.getSolde()|number_format(2, '.', ',') }} D.T
                                </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="alert alert-info mb-4" role="alert">
                            <i class="fas fa-info-circle"></i> 
                            The investment amount will be deducted from your selected bank account. 
                            Your investment will be pending until approved by our team.
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg" id="submitBtn">
                                <i class="fas fa-hand-holding-heart"></i> Confirm Investment
                            </button>
                            <a href="{{ path('app_projet_view', {id: projet.getIdprojet()}) }}" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
