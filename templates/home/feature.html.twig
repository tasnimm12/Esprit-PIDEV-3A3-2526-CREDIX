{% extends 'base.html.twig' %}

{% block title %}Features - Credix{% endblock %}

{% block content %}
    <!-- Features Start -->
    <div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
        <div class="container">
            <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
                <p class="d-inline-block border rounded text-primary fw-semi-bold py-1 px-3">Why Choose Us</p>
                <h1 class="display-5 mb-4">Our Key Features</h1>
            </div>
            <div class="row g-4">
                <div class="col-lg-4 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="feature-item text-center rounded p-4">
                        <div class="feature-icon mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle" style="width: 80px; height: 80px;">
                                <i class="fa fa-star text-primary" style="font-size: 32px;"></i>
                            </div>
                        </div>
                        <h4 class="mb-3">Expert Team</h4>
                        <p class="mb-0">Our team of experienced professionals are ready to assist you.</p>
                    </div>
                </div>
                <div class="col-lg-4 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="feature-item text-center rounded p-4">
                        <div class="feature-icon mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle" style="width: 80px; height: 80px;">
                                <i class="fa fa-lock text-primary" style="font-size: 32px;"></i>
                            </div>
                        </div>
                        <h4 class="mb-3">Secure & Safe</h4>
                        <p class="mb-0">Your data and investments are protected with the highest security.</p>
                    </div>
                </div>
                <div class="col-lg-4 wow fadeInUp" data-wow-delay="0.5s">
                    <div class="feature-item text-center rounded p-4">
                        <div class="feature-icon mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle" style="width: 80px; height: 80px;">
                                <i class="fa fa-headset text-primary" style="font-size: 32px;"></i>
                            </div>
                        </div>
                        <h4 class="mb-3">24/7 Support</h4>
                        <p class="mb-0">Our customer support team is always available to help you.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Features End -->
{% endblock %}
