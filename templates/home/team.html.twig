{% extends 'base.html.twig' %}

{% block title %}Team - Credix{% endblock %}

{% block content %}
    <!-- Team Start -->
    <div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
        <div class="container">
            <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
                <p class="d-inline-block border rounded text-primary fw-semi-bold py-1 px-3">Our Team</p>
                <h1 class="display-5 mb-4">Meet Our Team Members</h1>
            </div>
            <div class="row g-4">
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="team-item rounded overflow-hidden text-center h-100">
                        <div class="position-relative overflow-hidden" style="height: 300px;">
                            <img class="img-fluid w-100 h-100" src="{{ asset('img/carousel-1.jpg') }}" alt="">
                        </div>
                        <div class="py-4 px-3">
                            <h4 class="mb-1">John Smith</h4>
                            <p class="mb-3">Financial Advisor</p>
                            <div class="d-flex justify-content-center gap-2">
                                <a class="btn btn-sm btn-light rounded-circle" href=""><i class="fab fa-facebook-f"></i></a>
                                <a class="btn btn-sm btn-light rounded-circle" href=""><i class="fab fa-twitter"></i></a>
                                <a class="btn btn-sm btn-light rounded-circle" href=""><i class="fab fa-linkedin-in"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="team-item rounded overflow-hidden text-center h-100">
                        <div class="position-relative overflow-hidden" style="height: 300px;">
                            <img class="img-fluid w-100 h-100" src="{{ asset('img/carousel-2.jpg') }}" alt="">
                        </div>
                        <div class="py-4 px-3">
                            <h4 class="mb-1">Sarah Johnson</h4>
                            <p class="mb-3">Investment Manager</p>
                            <div class="d-flex justify-content-center gap-2">
                                <a class="btn btn-sm btn-light rounded-circle" href=""><i class="fab fa-facebook-f"></i></a>
                                <a class="btn btn-sm btn-light rounded-circle" href=""><i class="fab fa-twitter"></i></a>
                                <a class="btn btn-sm btn-light rounded-circle" href=""><i class="fab fa-linkedin-in"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                    <div class="team-item rounded overflow-hidden text-center h-100">
                        <div class="position-relative overflow-hidden" style="height: 300px;">
                            <img class="img-fluid w-100 h-100" src="{{ asset('img/about.jpg') }}" alt="">
                        </div>
                        <div class="py-4 px-3">
                            <h4 class="mb-1">Michael Brown</h4>
                            <p class="mb-3">Wealth Consultant</p>
                            <div class="d-flex justify-content-center gap-2">
                                <a class="btn btn-sm btn-light rounded-circle" href=""><i class="fab fa-facebook-f"></i></a>
                                <a class="btn btn-sm btn-light rounded-circle" href=""><i class="fab fa-twitter"></i></a>
                                <a class="btn btn-sm btn-light rounded-circle" href=""><i class="fab fa-linkedin-in"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Team End -->
{% endblock %}
