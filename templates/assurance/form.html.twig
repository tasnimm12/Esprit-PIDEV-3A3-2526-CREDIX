{% extends 'base.html.twig' %}

{% block title %}
    {% if assurance %}
        Edit Insurance Policy - Credix
    {% else %}
        New Insurance Policy - Credix
    {% endif %}
{% endblock %}

{% block content %}
    <div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <h2 class="display-6 mb-4">{{ title }}</h2>

                    {% if errors|length > 0 %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0 mt-2">
                                {% for error in errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endif %}

                    <form method="POST" class="border rounded p-5">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="typeAssurance" class="form-label">Insurance Type <span class="text-danger">*</span></label>
                                <select class="form-select" id="typeAssurance" name="type_assurance">
                                    <option value="">-- Select Type --</option>
                                    <option value="SANTE" {% if assurance and assurance.typeAssurance == 'SANTE' %}selected{% endif %}>Health</option>
                                    <option value="VIE" {% if assurance and assurance.typeAssurance == 'VIE' %}selected{% endif %}>Life</option>
                                    <option value="AUTO" {% if assurance and assurance.typeAssurance == 'AUTO' %}selected{% endif %}>Auto</option>
                                    <option value="HABITATION" {% if assurance and assurance.typeAssurance == 'HABITATION' %}selected{% endif %}>Home</option>
                                    <option value="RESPONSABILITE_CIVILE" {% if assurance and assurance.typeAssurance == 'RESPONSABILITE_CIVILE' %}selected{% endif %}>Liability</option>
                                    <option value="SCOLAIRE" {% if assurance and assurance.typeAssurance == 'SCOLAIRE' %}selected{% endif %}>School</option>
                                    <option value="VOYAGE" {% if assurance and assurance.typeAssurance == 'VOYAGE' %}selected{% endif %}>Travel</option>
                                    <option value="PROFESSIONNELLE" {% if assurance and assurance.typeAssurance == 'PROFESSIONNELLE' %}selected{% endif %}>Professional</option>
                                </select>
                                <small class="form-text text-muted">Required field</small>
                            </div>
                            <div class="col-md-6">
                                <label for="compagnie" class="form-label">Insurance Company <span class="text-danger">*</span></label>
                                <select class="form-select" id="compagnie" name="compagnie">
                                    <option value="">-- Select Company --</option>
                                    <option value="GAT" {% if assurance and assurance.compagnie == 'GAT' %}selected{% endif %}>GAT</option>
                                    <option value="COMAR" {% if assurance and assurance.compagnie == 'COMAR' %}selected{% endif %}>COMAR</option>
                                    <option value="BIAT" {% if assurance and assurance.compagnie == 'BIAT' %}selected{% endif %}>BIAT</option>
                                    <option value="ZITOUNA" {% if assurance and assurance.compagnie == 'ZITOUNA' %}selected{% endif %}>ZITOUNA</option>
                                </select>
                                <small class="form-text text-muted">Required field</small>
                            </div>
                                <small class="form-text text-muted">Max 100 characters</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="numeroPolice" class="form-label">Policy Number</label>
                                <input type="text" class="form-control" id="numeroPolice" name="numero_police" placeholder="Numéro de police"
                                    value="{{ assurance and assurance.numeroPolice ? assurance.numeroPolice : '' }}" placeholder="e.g., POL-123456">
                                <small class="form-text text-muted">Max 100 characters</small>
                            </div>
                            <div class="col-md-6">
                                <label for="montantCouverture" class="form-label">Coverage Amount ($)</label>
                                <input type="number" class="form-control" id="montantCouverture" 
                                    name="montant_couverture" value="{{ assurance and assurance.montantCouverture ? assurance.montantCouverture : '' }}"
                                    placeholder="50000.00">
                                <small class="form-text text-muted">Positive number only</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="franchise" class="form-label">Deductible ($)</label>
                                <input type="number" class="form-control" id="franchise" 
                                    name="franchise" value="{{ assurance and assurance.franchise ? assurance.franchise : '' }}"
                                    placeholder="500.00">
                                <small class="form-text text-muted">Positive number only</small>
                            </div>
                            <div class="col-md-6">
                                <label for="primeAnnuelle" class="form-label">Annual Premium ($)</label>
                                <input type="number" class="form-control" id="primeAnnuelle" 
                                    name="prime_annuelle" value="{{ assurance and assurance.primeAnnuelle ? assurance.primeAnnuelle : '' }}"
                                    placeholder="1200.00">
                                <small class="form-text text-muted">Positive number only</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="primeMensuelle" class="form-label">Monthly Premium ($)</label>
                                <input type="number" class="form-control" id="primeMensuelle" 
                                    name="prime_mensuelle" value="{{ assurance and assurance.primeMensuelle ? assurance.primeMensuelle : '' }}"
                                    placeholder="100.00">
                                <small class="form-text text-muted">Positive number only</small>
                            </div>
                            <div class="col-md-4">
                                <label for="prixAssurance" class="form-label">Subscription Cost ($)</label>
                                <input type="number" class="form-control" id="prixAssurance" 
                                    name="prix_assurance" value="{{ assurance and assurance.prixAssurance ? assurance.prixAssurance : '' }}"
                                    placeholder="150.00">
                                <small class="form-text text-muted">Cost to subscribe to this policy</small>
                            </div>
                            <div class="col-md-4">
                                <label for="dateDebut" class="form-label">Start Date</label>
                                <input type="date" class="form-control" id="dateDebut" name="date_debut" 
                                    value="{{ assurance and assurance.dateDebut ? assurance.dateDebut|date('Y-m-d') : '' }}">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="dateEcheance" class="form-label">Expiry Date</label>
                                <input type="date" class="form-control" id="dateEcheance" name="date_echeance" 
                                    value="{{ assurance and assurance.dateEcheance ? assurance.dateEcheance|date('Y-m-d') : '' }}">
                            </div>
                            <div class="col-md-6">
                                <label for="modePaiement" class="form-label">Payment Method</label>
                                <select class="form-select" id="modePaiement" name="mode_paiement">
                                    <option value="">-- Select Payment Method --</option>
                                    <option value="MENSUEL" {% if assurance and assurance.modePaiement == 'MENSUEL' %}selected{% endif %}>Monthly</option>
                                    <option value="TRIMESTRIEL" {% if assurance and assurance.modePaiement == 'TRIMESTRIEL' %}selected{% endif %}>Quarterly</option>
                                    <option value="SEMESTRIEL" {% if assurance and assurance.modePaiement == 'SEMESTRIEL' %}selected{% endif %}>Semi-Annual</option>
                                    <option value="ANNUEL" {% if assurance and assurance.modePaiement == 'ANNUEL' %}selected{% endif %}>Annual</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="statut" class="form-label">Status</label>
                                <select class="form-select" id="statut" name="statut">
                                    <option value="ACTIF" {% if assurance and assurance.statut == 'ACTIF' %}selected{% endif %}>Active</option>
                                    <option value="EXPIRE" {% if assurance and assurance.statut == 'EXPIRE' %}selected{% endif %}>Expired</option>
                                    <option value="RESILIE" {% if assurance and assurance.statut == 'RESILIE' %}selected{% endif %}>Terminated</option>
                                    <option value="SUSPENDU" {% if assurance and assurance.statut == 'SUSPENDU' %}selected{% endif %}>Suspended</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="renouvellementAuto" class="form-label">Auto Renewal</label>
                                <select class="form-select" id="renouvellementAuto" name="renouvellement_auto">
                                    <option value="0" {% if not assurance or not assurance.renouvellementAuto %}selected{% endif %}>No</option>
                                    <option value="1" {% if assurance and assurance.renouvellementAuto %}selected{% endif %}>Yes</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="garantiesIncluses" class="form-label">Coverage Details</label>
                            <textarea class="form-control" id="garantiesIncluses" name="garanties_incluses" rows="4" placeholder="List all covered items and exclusions...">{{ assurance and assurance.garantiesIncluses ? assurance.garantiesIncluses : '' }}</textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save me-2"></i>{{ assurance ? 'Update' : 'Create' }}
                            </button>
                            <a href="{{ path('app_assurance_list') }}" class="btn btn-secondary">
                                <i class="fa fa-arrow-left me-2"></i>Back
                            </a>
                        </div>

                        <p class="text-muted mt-3">
                            <small><span class="text-danger">*</span> = Required field</small>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

