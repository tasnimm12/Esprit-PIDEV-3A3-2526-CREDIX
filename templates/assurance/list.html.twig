{% extends 'base.html.twig' %}

{% block title %}Insurance Policies - Credix{% endblock %}

{% block content %}
<div class="policies-container" style="margin-top: 150px;">
    <!-- Header Section -->
    <div class="policies-header">
        <div class="container-xxl">
            <div class="row align-items-center mb-4">
                <div class="col-lg-8">
                    <h1 class="display-4 fw-bold mb-2" style="color: #1a3a52;">
                        <i class="fa fa-shield-alt me-3" style="color: #3498db;"></i>Insurance Policies
                    </h1>
                    <p class="text-muted mb-0">Manage and track all your insurance policies</p>
                </div>
                <div class="col-lg-4 text-end">
                    {% if app.user and app.user.role == 'admin' %}
                        <a href="{{ path('app_assurance_new') }}" class="btn btn-lg" style="background: linear-gradient(135deg, #3498db 0%, #2980b9 100%); color: white; border: none; box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);">
                            <i class="fa fa-plus me-2"></i>New Policy
                        </a>
                    {% endif %}
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon active-policies">
                            <i class="fa fa-check-circle"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Active</h6>
                            <p class="stat-number">{{ assurances|filter(a => a.statut == 'ACTIF')|length }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon inactive-policies">
                            <i class="fa fa-times-circle"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Inactive</h6>
                            <p class="stat-number">{{ assurances|filter(a => a.statut != 'ACTIF')|length }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon premium-total">
                            <i class="fa fa-dollar-sign"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Total Premium</h6>
                            <p class="stat-number">{{ assurances|reduce((carry, item) => carry + (item.primeMensuelle ?? 0), 0)|number_format(0, '.', ',') }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon total-policies">
                            <i class="fa fa-list"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Total Policies</h6>
                            <p class="stat-number">{{ assurances|length }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-xxl py-5">
        <div class="container">

            <!-- Search and Filters Section -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body">
                    <form method="GET" action="{{ path('app_assurance_list') }}" class="row g-3">
                        <!-- Search Bar -->
                        <div class="col-md-4">
                            <label class="form-label"><i class="fa fa-search me-2"></i>Search</label>
                            <input type="text" name="search" class="form-control" placeholder="Company, Policy #..." value="{{ app.request.query.get('search') }}">
                        </div>

                        <!-- Status Filter -->
                        <div class="col-md-3">
                            <label class="form-label"><i class="fa fa-filter me-2"></i>Status</label>
                            <select name="status" class="form-select">
                                <option value="">All Statuses</option>
                                <option value="ACTIF" {% if app.request.query.get('status') == 'ACTIF' %}selected{% endif %}>Active</option>
                                <option value="INACTIF" {% if app.request.query.get('status') == 'INACTIF' %}selected{% endif %}>Inactive</option>
                            </select>
                        </div>

                        <!-- Sort By -->
                        <div class="col-md-3">
                            <label class="form-label"><i class="fa fa-sort me-2"></i>Sort By</label>
                            <select name="sort" class="form-select">
                                <option value="">Default</option>
                                
                                <option value="recent" {% if app.request.query.get('sort') == 'recent' %}selected{% endif %}>Most Recent</option>
                                <option value="oldest" {% if app.request.query.get('sort') == 'oldest' %}selected{% endif %}>Oldest First</option>
                            </select>
                        </div>

                        <!-- Buttons -->
                        <div class="col-md-2 d-flex gap-2 align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa fa-search me-1"></i>Filter
                            </button>
                            <a href="{{ path('app_assurance_list') }}" class="btn btn-secondary">
                                <i class="fa fa-redo"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

               <div class="row g-4">
                    {% if assurances|length > 0 %}
                        {% for assurance in assurances %}
                            <div class="col-lg-6 col-xl-4">
                                <div class="policy-card shadow-lg border-0">
                                    <div class="policy-card-header">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h5 class="policy-id">
                                                    <i class="fa fa-building me-2"></i>{{ assurance.compagnie ?? 'Policy' }}
                                                </h5>
                                            </div>
                                            {% if assurance.statut == 'ACTIF' %}
                                                <span class="badge badge-lg bg-success" style="font-size: 0.75rem;">Active</span>
                                            {% else %}
                                                <span class="badge badge-lg bg-warning text-dark" style="font-size: 0.75rem;">Inactive</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="policy-info-block">
                                            <div class="policy-info">
                                                <label class="policy-label">
                                                    <i class="fa fa-tag"></i> Policy #
                                                </label>
                                                <p class="policy-value">{{ assurance.id }}</p>
                                            </div>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <div class="policy-info">
                                                    <label class="policy-label">
                                                        <i class="fa fa-layer-group"></i> Type
                                                    </label>
                                                    <p class="policy-value">{{ assurance.typeAssurance ?? 'N/A' }}</p>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="policy-info">
                                                    <label class="policy-label">
                                                        <i class="fa fa-dollar-sign"></i> Monthly
                                                    </label>
                                                    <p class="policy-value">{% if assurance.primeMensuelle %}${{ assurance.primeMensuelle|number_format(2, '.', ',') }}{% else %}N/A{% endif %}</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="policy-info-block mt-2 pt-2 border-top">
                                            <label class="policy-label">
                                                <i class="fa fa-credit-card"></i> Subscription Cost
                                            </label>
                                            <p class="policy-value" style="color: #3498db; font-size: 18px; font-weight: bold;">{% if assurance.prixAssurance %}${{ assurance.prixAssurance|number_format(2, '.', ',') }}{% else %}N/A{% endif %}</p>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-white border-top">
                                        <div class="d-grid gap-2">
                                            <a href="{{ path('app_assurance_show', { id: assurance.id }) }}" class="btn btn-primary btn-sm">
                                                <i class="fa fa-eye me-1"></i>View Details
                                            </a>
                                        </div>
                                        <div class="d-flex gap-2 mt-2">
                                            {% if app.user and app.user.role == 'admin' %}
                                                <a href="{{ path('app_assurance_edit', { id: assurance.id }) }}" class="btn btn-sm btn-outline-warning flex-grow-1" title="Edit">
                                                    <i class="fa fa-edit me-1"></i>Edit
                                                </a>
                                                <a href="{{ path('app_assurance_delete', { id: assurance.id }) }}" class="btn btn-sm btn-outline-danger flex-grow-1" onclick="return confirm('Are you sure?')" title="Delete">
                                                    <i class="fa fa-trash me-1"></i>Delete
                                                </a>
                                            {% else %}
                                                <a href="{{ path('app_contract_new') }}?assurance_id={{ assurance.id }}" class="btn btn-sm btn-success flex-grow-1">
                                                    <i class="fa fa-handshake me-1"></i>Subscribe
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
    {% else %}
        <div class="col-12 text-center text-muted py-5">
            No insurance policies found.
        </div>
    {% endif %}
        </div>
        </div>
    </div>
</div>

<style>
    .policies-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
    }

    .policies-header {
        background: white;
        padding: 40px 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* Statistics Cards */
    .stat-card {
        display: flex;
        align-items: center;
        padding: 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        font-size: 24px;
    }

    .stat-icon.active-policies {
        background: #d4edda;
        color: #28a745;
    }

    .stat-icon.inactive-policies {
        background: #f8d7da;
        color: #dc3545;
    }

    .stat-icon.premium-total {
        background: #fff3cd;
        color: #ff9800;
    }

    .stat-icon.total-policies {
        background: #d1ecf1;
        color: #17a2b8;
    }

    .stat-number {
        font-size: 28px;
        font-weight: bold;
        color: #1a3a52;
        margin: 0;
    }

    /* Policy Cards */
    .policy-card {
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        background: white;
    }

    .policy-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15) !important;
    }

    .policy-card-header {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
        padding: 20px;
    }

    .policy-id {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
        color: white;
    }

    .policy-label {
        font-size: 12px;
        font-weight: 600;
        color: #7f8fa3;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
    }

    .policy-value {
        font-size: 16px;
        font-weight: 500;
        color: #1a3a52;
        margin: 5px 0 0 0;
    }

    .badge-lg {
        padding: 0.5rem 0.75rem;
        font-weight: 600;
    }

    .btn-primary {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        border: none;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #2980b9 0%, #1f5a96 100%);
        box-shadow: 0 6px 16px rgba(52, 152, 219, 0.4);
    }
</style>

{% endblock %}
