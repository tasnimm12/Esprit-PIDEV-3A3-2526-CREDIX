{% extends 'base.html.twig' %}

{% block title %}Projects - Investment Platform{% endblock %}

{% block content %}
<div class="projects-container" style="margin-top: 150px;">
    <!-- Header Section -->
    <div class="projects-header">
        <div class="container-xxl">
            <div class="row align-items-center mb-4">
                <div class="col-lg-8">
                    <h1 class="display-4 fw-bold mb-2" style="color: #1a3a52;">
                        <i class="fa fa-folder-open me-3" style="color: #27ae60;"></i>Investment Projects
                    </h1>
                    <p class="text-muted mb-0">Discover and invest in promising projects</p>
                </div>
                <div class="col-lg-4 text-end">
                    {% if isAdmin %}
                        <a href="{{ path('app_admin_projets') }}" class="btn btn-lg" style="background: linear-gradient(135deg, #27ae60 0%, #1e8449 100%); color: white; border: none; box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);">
                            <i class="fa fa-cog me-2"></i>Manage Projects
                        </a>
                    {% endif %}
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon active-projects">
                            <i class="fa fa-play-circle"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Active Projects</h6>
                            <p class="stat-number">{{ projets|filter(p => p.getStatutProjet() == 'ACTIF')|length }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon suspended-projects">
                            <i class="fa fa-pause-circle"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Suspended</h6>
                            <p class="stat-number">{{ projets|filter(p => p.getStatutProjet() == 'SUSPENDU')|length }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon completed-projects">
                            <i class="fa fa-check-circle"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Completed</h6>
                            <p class="stat-number">{{ projets|filter(p => p.getStatutProjet() == 'TERMINE')|length }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon total-projects">
                            <i class="fa fa-list"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Total Projects</h6>
                            <p class="stat-number">{{ projets|length }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-xxl py-5">
        <div class="container">

    <!-- Search, Filter, and Sort Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-3">
                <!-- Search -->
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control" placeholder="Search projects..." value="{{ search }}">
                </div>

                <!-- Sector Filter -->
                <div class="col-md-2">
                    <select name="secteur" class="form-select">
                        <option value="">All Sectors</option>
                        {% for s in secteurs %}
                        <option value="{{ s }}" {% if secteur == s %}selected{% endif %}>{{ s }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-md-2">
                    <select name="statut" class="form-select">
                        <option value="">All Status</option>
                        {% for stat in statutOptions %}
                        <option value="{{ stat }}" {% if statut == stat %}selected{% endif %}>{{ stat }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Sort By -->
                <div class="col-md-2">
                    <select name="sort" class="form-select">
                        <option value="date_debut" {% if sortBy == 'date_debut' %}selected{% endif %}>Date Started</option>
                        <option value="name" {% if sortBy == 'name' %}selected{% endif %}>Name</option>
                        <option value="target" {% if sortBy == 'target' %}selected{% endif %}>Target Amount</option>
                        <option value="status" {% if sortBy == 'status' %}selected{% endif %}>Status</option>
                    </select>
                </div>

                <!-- Sort Order -->
                <div class="col-md-2">
                    <select name="order" class="form-select">
                        <option value="desc" {% if sortOrder == 'desc' %}selected{% endif %}>Descending</option>
                        <option value="asc" {% if sortOrder == 'asc' %}selected{% endif %}>Ascending</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Filter
                    </button>
                </div>

                <div class="col-md-2">
                    <a href="{{ path('app_projet_list') }}" class="btn btn-secondary w-100">
                        <i class="fas fa-redo"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    {% if projets|length == 0 %}
        <div class="alert alert-info text-center py-5">
            <i class="fa fa-info-circle me-2"></i>
            <p class="mb-0">No projects available at this time.</p>
        </div>
    {% else %}
        <div class="row g-4">
            {% for projet in projets %}
            <div class="col-lg-6 col-xl-4">
                <div class="projet-card shadow-lg border-0">
                    <div class="projet-card-header">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="projet-id">
                                    <i class="fa fa-folder me-2"></i>{{ projet.getNomprojet() }}
                                </h5>
                            </div>
                            <span class="badge badge-lg {% if projet.getStatutProjet() == 'ACTIF' %}bg-success{% elseif projet.getStatutProjet() == 'SUSPENDU' %}bg-warning text-dark{% else %}bg-danger{% endif %}" style="font-size: 0.75rem;">{{ projet.getStatutProjet() }}</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="projet-info-block">
                            <div class="projet-info">
                                <label class="projet-label">
                                    <i class="fa fa-building"></i> Sector
                                </label>
                                <p class="projet-value">{{ projet.getSecteur() }}</p>
                            </div>
                        </div>
                        {% if projet.getDescription() %}
                        <div class="projet-info-block mt-2 pt-2 border-top">
                            <label class="projet-label">
                                <i class="fa fa-align-left"></i> Description
                            </label>
                            <p class="projet-description">{{ projet.getDescription()|slice(0, 100) }}{% if projet.getDescription()|length > 100 %}...{% endif %}</p>
                        </div>
                        {% endif %}
                        <div class="projet-info-block mt-2 pt-2 border-top">
                            <label class="projet-label">
                                <i class="fa fa-bullseye"></i> Target Amount
                            </label>
                            <p class="projet-value" style="color: #27ae60; font-size: 18px; font-weight: bold;">{{ projet.getMontantObjectif()|number_format(2, '.', ',') }} D.T</p>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top">
                        <div class="d-grid gap-2">
                            <a href="{{ path('app_projet_view', {id: projet.getIdprojet()}) }}" class="btn btn-primary btn-sm">
                                <i class="fa fa-eye me-1"></i>View Details
                            </a>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            {% if projet.getStatutProjet() == 'ACTIF' and app.user %}
                                <a href="{{ path('app_investissement_create', {projetId: projet.getIdprojet()}) }}" class="btn btn-sm btn-success flex-grow-1">
                                    <i class="fas fa-hand-holding-heart me-1"></i>Invest Now
                                </a>
                            {% elseif projet.getStatutProjet() != 'ACTIF' %}
                                <button class="btn btn-sm btn-secondary flex-grow-1" disabled>
                                    <i class="fas fa-lock me-1"></i>Not Available
                                </button>
                            {% elseif not app.user %}
                                <a href="{{ path('app_login') }}" class="btn btn-sm btn-success flex-grow-1">
                                    <i class="fas fa-sign-in-alt me-1"></i>Login
                                </a>
                            {% endif %}
                            {% if isAdmin %}
                                <a href="{{ path('app_projet_edit', {id: projet.getIdprojet()}) }}" class="btn btn-sm btn-outline-secondary flex-grow-1">
                                    <i class="fas fa-edit me-1"></i>Edit
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}
        </div>
    </div>
</div>

<style>
    .projects-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
    }

    .projects-header {
        background: white;
        padding: 40px 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .stat-card {
        display: flex;
        align-items: center;
        padding: 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        font-size: 24px;
    }

    .stat-icon.active-projects {
        background: #d4edda;
        color: #28a745;
    }

    .stat-icon.suspended-projects {
        background: #fff3cd;
        color: #ff9800;
    }

    .stat-icon.completed-projects {
        background: #d1ecf1;
        color: #17a2b8;
    }

    .stat-icon.total-projects {
        background: #e2e3e5;
        color: #666;
    }

    .stat-number {
        font-size: 28px;
        font-weight: bold;
        color: #1a3a52;
        margin: 0;
    }

    .projet-card {
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        background: white;
    }

    .projet-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15) !important;
    }

    .projet-card-header {
        background: linear-gradient(135deg, #27ae60 0%, #1e8449 100%);
        color: white;
        padding: 20px;
    }

    .projet-id {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
        color: white;
    }

    .projet-label {
        font-size: 12px;
        font-weight: 600;
        color: #7f8fa3;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
    }

    .projet-value {
        font-size: 16px;
        font-weight: 500;
        color: #1a3a52;
        margin: 5px 0 0 0;
    }

    .projet-description {
        font-size: 14px;
        color: #555;
        margin: 5px 0 0 0;
        line-height: 1.4;
    }

    .badge-lg {
        padding: 0.5rem 0.75rem;
        font-weight: 600;
    }

    .btn-primary {
        background: linear-gradient(135deg, #27ae60 0%, #1e8449 100%);
        border: none;
        box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #1e8449 0%, #186a3b 100%);
        box-shadow: 0 6px 16px rgba(39, 174, 96, 0.4);
    }
</style>

{% endblock %}
