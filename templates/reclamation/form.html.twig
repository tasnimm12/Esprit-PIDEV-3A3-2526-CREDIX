{% extends 'base.html.twig' %}

{% block title %}Submit Reclamation - Credix{% endblock %}

{% block content %}
<div class="container py-5" style="margin-top: 120px;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Back Button -->
            <a href="{% if abonnement %}{{ path('app_abonnement_detail', {id: abonnement.idAbonnement}) }}{% else %}{{ path('app_abonnement_list') }}{% endif %}" class="btn btn-outline-secondary mb-4">
                <i class="fa fa-arrow-left me-2"></i>Back
            </a>

            <div class="card border-0 shadow">
                <div class="card-header bg-danger text-white py-4">
                    <h1 class="h3 mb-0">
                        <i class="fa fa-exclamation-circle me-2"></i>Submit a Reclamation
                    </h1>
                </div>

                <div class="card-body p-5">
                    <!-- Info Alert -->
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="fa fa-info-circle me-2"></i>
                        <strong>We're Here to Help!</strong> Please describe your issue in detail so our team can assist you promptly.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>

                    <!-- Display Flash Messages -->
                    {% if app.flashes('error') %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fa fa-times-circle me-2"></i>{{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                    {% endif %}

                    <form method="POST" action="{{ path('app_reclamation_submit') }}" id="reclamationForm">
                        <!-- CSRF Token -->
                        <input type="hidden" name="_token" value="{{ csrf_token('reclamation_create') }}">

                        <!-- Related Plan (if applicable) -->
                        {% if abonnement %}
                            <div class="mb-4">
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <p class="mb-0">
                                            <strong>Related Plan:</strong> 
                                            <span class="badge bg-primary">{{ abonnement.typeAbonnement }}</span>
                                        </p>
                                    </div>
                                </div>
                                <input type="hidden" name="abonnement_id" value="{{ abonnement.idAbonnement }}">
                            </div>
                        {% else %}
                            <input type="hidden" name="abonnement_id" value="">
                        {% endif %}

                        <!-- Subject -->
                        <div class="form-group mb-4">
                            <label for="subject" class="form-label">
                                <i class="fa fa-heading me-2"></i>Subject <span class="text-danger">*</span>
                            </label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="subject" 
                                name="subject" 
                                placeholder="Brief description of your issue"
                                minlength="5"
                                maxlength="100"
                                required
                            >
                            <small class="form-text text-muted">Between 5-100 characters</small>
                        </div>

                        <!-- Category -->
                        <div class="form-group mb-4">
                            <label for="category" class="form-label">
                                <i class="fa fa-tag me-2"></i>Category <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="category" name="category" required>
                                <option value="">-- Select Category --</option>
                                <option value="general">General Inquiry</option>
                                <option value="billing">Billing Issue</option>
                                <option value="technical">Technical Problem</option>
                                <option value="service">Service Complaint</option>
                            </select>
                        </div>

                        <!-- Description -->
                        <div class="form-group mb-4">
                            <label for="description" class="form-label">
                                <i class="fa fa-align-left me-2"></i>Description <span class="text-danger">*</span>
                            </label>
                            <textarea 
                                class="form-control" 
                                id="description" 
                                name="description" 
                                rows="8"
                                placeholder="Please provide detailed information about your issue. Include any relevant dates, actions taken, or reference numbers."
                                minlength="20"
                                maxlength="5000"
                                required
                            ></textarea>
                            <small class="form-text text-muted">
                                <span id="charCount">0</span>/5000 characters (minimum 20)
                            </small>
                        </div>

                        <!-- Form Actions -->
                        <div class="row">
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-danger w-100 py-2">
                                    <i class="fa fa-paper-plane me-2"></i>Submit Reclamation
                                </button>
                            </div>
                            <div class="col-md-6">
                                <a href="{% if abonnement %}{{ path('app_abonnement_detail', {id: abonnement.idAbonnement}) }}{% else %}{{ path('app_abonnement_list') }}{% endif %}" class="btn btn-outline-secondary w-100 py-2">
                                    <i class="fa fa-times me-2"></i>Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Section -->
            <div class="card border-0 shadow mt-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="fa fa-question-circle me-2"></i>Need Help?</h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>Be as detailed as possible to help us understand your issue</li>
                        <li>Include dates and specific references when applicable</li>
                        <li>Describe any steps you've already taken</li>
                        <li>Our team will review and respond within 24-48 hours</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const textarea = document.getElementById('description');
    const charCount = document.getElementById('charCount');

    textarea.addEventListener('input', function() {
        charCount.textContent = this.value.length;
    });
});
</script>
{% endblock %}
