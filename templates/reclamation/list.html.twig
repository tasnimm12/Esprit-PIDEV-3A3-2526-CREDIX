{% extends 'base.html.twig' %}

{% block title %}My Reclamations - Credix{% endblock %}

{% block content %}
<div class="container py-5" style="margin-top: 120px;">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Header -->
            <div class="mb-4">
                <a href="{{ path('app_abonnement_list') }}" class="btn btn-outline-secondary mb-3">
                    <i class="fa fa-arrow-left me-2"></i>Back to Plans
                </a>
                <h1 class="h2 fw-bold">
                    <i class="fa fa-list me-2"></i>My Reclamations
                </h1>
                <p class="text-muted">Track and manage your submitted complaints and issues</p>
            </div>

            <!-- New Reclamation Button -->
            <div class="mb-4">
                <a href="{{ path('app_reclamation_new') }}" class="btn btn-danger">
                    <i class="fa fa-plus me-2"></i>Submit New Reclamation
                </a>
            </div>

            <!-- Display Flash Messages -->
            {% if app.flashes('success') %}
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa fa-check-circle me-2"></i>{{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endif %}

            <!-- Reclamations List -->
            {% if reclamations|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover border-0">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fa fa-heading me-2"></i>Subject</th>
                                <th><i class="fa fa-tag me-2"></i>Category</th>
                                <th><i class="fa fa-info-circle me-2"></i>Status</th>
                                <th><i class="fa fa-calendar me-2"></i>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reclamation in reclamations %}
                                <tr>
                                    <td>
                                        <strong>{{ reclamation.subject }}</strong>
                                        {% if reclamation.abonnement %}
                                            <br><small class="text-muted">Plan: {{ reclamation.abonnement.typeAbonnement }}</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-info">
                                            {{ reclamation.category|title }}
                                        </span>
                                    </td>
                                    <td>
                                        {% set statusClass = {
                                            'pending': 'warning',
                                            'in_progress': 'primary',
                                            'resolved': 'success',
                                            'closed': 'secondary'
                                        } %}
                                        <span class="badge bg-{{ statusClass[reclamation.status] ?? 'secondary' }}">
                                            <i class="fa fa-{% if reclamation.status == 'pending' %}hourglass-half{% elseif reclamation.status == 'in_progress' %}spinner{% elseif reclamation.status == 'resolved' %}check{% else %}lock{% endif %} me-1"></i>
                                            {{ reclamation.status|replace({'_': ' '})|title }}
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">{{ reclamation.createdAt|date('M d, Y H:i') }}</small>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#detailModal{{ reclamation.id }}">
                                            <i class="fa fa-eye me-1"></i>View
                                        </button>
                                    </td>
                                </tr>

                                <!-- Detail Modal -->
                                <div class="modal fade" id="detailModal{{ reclamation.id }}" tabindex="-1">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">{{ reclamation.subject }}</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <strong>Category:</strong> <span class="badge bg-info">{{ reclamation.category|title }}</span>
                                                </div>
                                                <div class="mb-3">
                                                    <strong>Status:</strong> 
                                                    {% set statusClass = {
                                                        'pending': 'warning',
                                                        'in_progress': 'primary',
                                                        'resolved': 'success',
                                                        'closed': 'secondary'
                                                    } %}
                                                    <span class="badge bg-{{ statusClass[reclamation.status] ?? 'secondary' }}">{{ reclamation.status|replace({'_': ' '})|title }}</span>
                                                </div>
                                                {% if reclamation.abonnement %}
                                                    <div class="mb-3">
                                                        <strong>Related Plan:</strong> {{ reclamation.abonnement.typeAbonnement }}
                                                    </div>
                                                {% endif %}
                                                <div class="mb-3">
                                                    <strong>Date Submitted:</strong> {{ reclamation.createdAt|date('F d, Y H:i') }}
                                                </div>
                                                <hr>
                                                <div class="mb-3">
                                                    <h6>Description</h6>
                                                    <p class="text-muted">{{ reclamation.description|nl2br }}</p>
                                                </div>
                                                {% if reclamation.adminResponse %}
                                                    <hr>
                                                    <div class="alert alert-info">
                                                        <h6><i class="fa fa-reply me-2"></i>Admin Response</h6>
                                                        <p class="mb-0">{{ reclamation.adminResponse|nl2br }}</p>
                                                    </div>
                                                {% endif %}
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info text-center py-5">
                    <i class="fa fa-inbox fa-3x mb-3"></i>
                    <h5>No Reclamations Yet</h5>
                    <p class="text-muted mb-0">You haven't submitted any reclamations. If you have an issue, please submit one now.</p>
                    <a href="{{ path('app_reclamation_new') }}" class="btn btn-danger mt-3">
                        <i class="fa fa-plus me-2"></i>Submit Reclamation
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
