{% extends 'base_admin.html.twig' %}

{% block title %}Manage Projects - Admin - Credix{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">Projects Management</h1>
            <p class="text-muted">Create, edit, and manage all investment projects</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('app_admin_projet_create') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New Project
            </a>
        </div>
    </div>

    <!-- Search, Filter, and Sort Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-3">
                <!-- Search -->
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control" placeholder="Search projects..." value="{{ search }}">
                </div>

                <!-- Sector Filter -->
                <div class="col-md-2">
                    <select name="secteur" class="form-select">
                        <option value="">All Sectors</option>
                        {% for s in secteurs %}
                        <option value="{{ s }}" {% if secteur == s %}selected{% endif %}>{{ s }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-md-2">
                    <select name="statut" class="form-select">
                        <option value="">All Status</option>
                        {% for stat in statutOptions %}
                        <option value="{{ stat }}" {% if statut == stat %}selected{% endif %}>{{ stat }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Sort By -->
                <div class="col-md-2">
                    <select name="sort" class="form-select">
                        <option value="date_debut" {% if sortBy == 'date_debut' %}selected{% endif %}>Date Started</option>
                        <option value="name" {% if sortBy == 'name' %}selected{% endif %}>Name</option>
                        <option value="target" {% if sortBy == 'target' %}selected{% endif %}>Target Amount</option>
                        <option value="status" {% if sortBy == 'status' %}selected{% endif %}>Status</option>
                    </select>
                </div>

                <!-- Sort Order -->
                <div class="col-md-2">
                    <select name="order" class="form-select">
                        <option value="desc" {% if sortOrder == 'desc' %}selected{% endif %}>Descending</option>
                        <option value="asc" {% if sortOrder == 'asc' %}selected{% endif %}>Ascending</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Filter
                    </button>
                </div>

                <div class="col-md-1">
                    <a href="{{ path('app_admin_projets') }}" class="btn btn-secondary w-100">
                        <i class="fas fa-redo"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Projects Table -->
    {% if projets|length == 0 %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No projects found.
        </div>
    {% else %}
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Project Name</th>
                            <th>Sector</th>
                            <th>Target Amount</th>
                            <th>Collected</th>
                            <th>Progress</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for projet in projets %}
                            <tr>
                                <td><strong>{{ projet.getNomprojet() }}</strong></td>
                                <td>{{ projet.getSecteur() }}</td>
                                <td>{{ projet.getMontantObjectif()|number_format(2, '.', ',') }} D.T</td>
                                <td>{{ projet.getMontantCollecte()|number_format(2, '.', ',') }} D.T</td>
                                <td>
                                    {% set percent = projet.getMontantObjectif() > 0 ? (projet.getMontantCollecte() / projet.getMontantObjectif() * 100)|round : 0 %}
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar" role="progressbar" style="width: {{ percent }}%" aria-valuenow="{{ percent }}" aria-valuemin="0" aria-valuemax="100">
                                            {{ percent }}%
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-{% if projet.getStatutProjet() == 'ACTIF' %}success{% elseif projet.getStatutProjet() == 'SUSPENDU' %}warning{% elseif projet.getStatutProjet() == 'TERMINE' %}secondary{% else %}danger{% endif %}">
                                        {{ projet.getStatutProjet() }}
                                    </span>
                                </td>
                                <td>{{ projet.getDateDebut()|date('d/m/Y') }}</td>
                                <td>
                                    <a href="{{ path('app_projet_view', {id: projet.getIdprojet()}) }}" class="btn btn-sm btn-outline-primary" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_admin_projet_edit', {id: projet.getIdprojet()}) }}" class="btn btn-sm btn-outline-secondary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="POST" action="{{ path('app_admin_projet_delete', {id: projet.getIdprojet()}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this project?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
