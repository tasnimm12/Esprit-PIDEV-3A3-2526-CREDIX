{% extends 'base_admin.html.twig' %}

{% block title %}Manage Investments - Admin - Credix{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-0">Investment Management</h1>
            <p class="text-muted">Review and approve/reject user investments</p>
        </div>
    </div>

    {% if app.flashes %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                    {% if type == 'error' %}<i class="fas fa-exclamation-circle me-2"></i>{% else %}<i class="fas fa-check-circle me-2"></i>{% endif %}
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Invested</h6>
                    <h3 class="text-primary">{{ totalInvesti|number_format(2, '.', ',') }} D.T</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <h6 class="text-muted">Pending</h6>
                    <h3 class="text-warning">{{ pendingCount }}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h6 class="text-muted">Accepted</h6>
                    <h3 class="text-success">{{ acceptedCount }}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger">
                <div class="card-body text-center">
                    <h6 class="text-muted">Rejected</h6>
                    <h3 class="text-danger">{{ rejectedCount }}</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Search, Filter, and Sort Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-3">
                <!-- Search -->
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control" placeholder="Search projects or users..." value="{{ search }}">
                </div>

                <!-- Status Filter -->
                <div class="col-md-2">
                    <select name="statut" class="form-select">
                        <option value="">All Status</option>
                        {% for stat in statutOptions %}
                        <option value="{{ stat }}" {% if statut == stat %}selected{% endif %}>{{ stat }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Sort By -->
                <div class="col-md-2">
                    <select name="sort" class="form-select">
                        <option value="dateinves" {% if sortBy == 'dateinves' %}selected{% endif %}>Date</option>
                        <option value="montant" {% if sortBy == 'montant' %}selected{% endif %}>Amount</option>
                        <option value="projet" {% if sortBy == 'projet' %}selected{% endif %}>Project</option>
                        <option value="utilisateur" {% if sortBy == 'utilisateur' %}selected{% endif %}>User</option>
                    </select>
                </div>

                <!-- Sort Order -->
                <div class="col-md-2">
                    <select name="order" class="form-select">
                        <option value="desc" {% if sortOrder == 'desc' %}selected{% endif %}>Descending</option>
                        <option value="asc" {% if sortOrder == 'asc' %}selected{% endif %}>Ascending</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Filter
                    </button>
                </div>

                <div class="col-md-1">
                    <a href="{{ path('app_admin_investissements') }}" class="btn btn-secondary w-100">
                        <i class="fas fa-redo"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Investments Table -->
    {% if investissements|length == 0 %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No investments found.
        </div>
    {% else %}
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Project</th>
                            <th>User</th>
                            <th>Amount</th>
                            <th>Payment Method</th>
                            <th>Account</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for inv in investissements %}
                            <tr>
                                <td>{{ inv.getDateinves()|date('d/m/Y') }}</td>
                                <td>
                                    <a href="{{ path('app_projet_view', {id: inv.getProjet().getIdprojet()}) }}">
                                        {{ inv.getProjet().getNomprojet() }}
                                    </a>
                                </td>
                                <td>
                                    {% if inv.getUtilisateur() %}
                                        {{ inv.getUtilisateur().getPrenom() }} {{ inv.getUtilisateur().getNom() }}
                                    {% else %}
                                        <span class="text-muted">N/A</span>
                                    {% endif %}
                                </td>
                                <td><strong>{{ inv.getMontantinvesti()|number_format(2, '.', ',') }} D.T</strong></td>
                                <td>{{ inv.getModepaiement() }}</td>
                                <td>
                                    {% if inv.getCompte() %}
                                        {{ inv.getCompte().getNumeroCompte() }}
                                    {% else %}
                                        <span class="text-muted">N/A</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-{% if inv.getStatutInvestissement() == 'EN_ATTENTE' %}warning{% elseif inv.getStatutInvestissement() == 'ACCEPTE' %}success{% elseif inv.getStatutInvestissement() == 'REJETE' %}danger{% else %}secondary{% endif %}">
                                        {{ inv.getStatutInvestissement() }}
                                    </span>
                                </td>
                                <td>
                                    <a href="{{ path('app_admin_investissement_view', {id: inv.getIdinves()}) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
