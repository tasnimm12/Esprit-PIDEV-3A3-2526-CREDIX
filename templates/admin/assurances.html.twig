{% extends 'base_admin.html.twig' %}

{% block title %}Manage Insurance Policies - Admin - Credix{% endblock %}

{% block breadcrumb_current %}Manage Policies{% endblock %}

{% block content %}
    <div class="container-fluid">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="display-6 mb-0">Manage Insurance Policies</h1>
                        <p class="text-muted">View and manage all insurance policies</p>
                    </div>
                    <a href="{{ path('app_assurance_new') }}" class="btn btn-primary">
                        <i class="fa fa-plus me-2"></i>New Policy
                    </a>
                </div>
            </div>
        </div>

            <!-- Filter Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <form method="GET" action="{{ path('app_admin_assurances') }}" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Search</label>
                            <input type="text" name="search" class="form-control" placeholder="Company, policy #..." value="{{ search }}">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="">All Status</option>
                                <option value="ACTIF" {% if status == 'ACTIF' %}selected{% endif %}>Active</option>
                                <option value="INACTIF" {% if status == 'INACTIF' %}selected{% endif %}>Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Sort By</label>
                            <select name="sort" class="form-select">
                                <option value="id" {% if sort == 'id' %}selected{% endif %}>ID</option>
                                <option value="compagnie" {% if sort == 'compagnie' %}selected{% endif %}>Company</option>
                                <option value="montantCouverture" {% if sort == 'montantCouverture' %}selected{% endif %}>Coverage</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2 align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa fa-filter me-1"></i>Filter
                            </button>
                            <a href="{{ path('app_admin_assurances') }}" class="btn btn-secondary">
                                <i class="fa fa-redo"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Assurances Table -->
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Company</th>
                                <th>Type</th>
                                <th>Policy #</th>
                                <th>Coverage Amount</th>
                                <th>Premium</th>
                                <th>Subscription Cost</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if assurances|length > 0 %}
                                {% for assurance in assurances %}
                                    <tr>
                                        <td>
                                            <small class="text-muted">#{{ assurance.id }}</small>
                                        </td>
                                        <td>
                                            <strong>{{ assurance.compagnie }}</strong>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">{{ assurance.typeAssurance }}</span>
                                        </td>
                                        <td>
                                            <small>{{ assurance.numeroPolice }}</small>
                                        </td>
                                        <td>
                                            {% if assurance.montantCouverture %}
                                                <strong>${{ assurance.montantCouverture|number_format(2, '.', ',') }}</strong>
                                            {% else %}
                                                N/A
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if assurance.primeAnnuelle %}
                                                <small>${{ assurance.primeAnnuelle|number_format(2) }}/yr</small>
                                            {% else %}
                                                N/A
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if assurance.prixAssurance %}
                                                <strong class="text-success">${{ assurance.prixAssurance|number_format(2) }}</strong>
                                            {% else %}
                                                <span class="text-muted">N/A</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if assurance.statut == 'ACTIF' %}
                                                <span class="badge bg-success">Active</span>
                                            {% else %}
                                                <span class="badge bg-secondary">Inactive</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="{{ path('app_assurance_show', {id: assurance.id}) }}" class="btn btn-outline-info" title="View">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                                <a href="{{ path('app_assurance_edit', {id: assurance.id}) }}" class="btn btn-outline-warning" title="Edit">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <a href="{{ path('app_assurance_delete', {id: assurance.id}) }}" class="btn btn-outline-danger" title="Delete" onclick="return confirm('Are you sure?')">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-4">
                                        <i class="fa fa-inbox me-2"></i>No policies found
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
