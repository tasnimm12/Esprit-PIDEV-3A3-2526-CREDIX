{% extends 'base_admin.html.twig' %}

{% block title %}Manage Users - Admin - Credix{% endblock %}

{% block breadcrumb_current %}Manage Users{% endblock %}

{% block content %}
    <div class="container-fluid">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="display-6 mb-0">Manage Users</h1>
                <p class="text-muted">View and manage all system users</p>

            <!-- Filter Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <form method="GET" action="{{ path('app_admin_users') }}" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Search</label>
                            <input type="text" name="search" class="form-control" placeholder="Name, email..." value="{{ search }}">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Role</label>
                            <select name="role" class="form-select">
                                <option value="">All Roles</option>
                                <option value="admin" {% if role == 'admin' %}selected{% endif %}>Admin</option>
                                <option value="client" {% if role == 'client' %}selected{% endif %}>Client</option>
                                <option value="organisateur" {% if role == 'organisateur' %}selected{% endif %}>Organisateur</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Sort By</label>
                            <select name="sort" class="form-select">
                                <option value="id" {% if sort == 'id' %}selected{% endif %}>ID</option>
                                <option value="nom" {% if sort == 'nom' %}selected{% endif %}>Name</option>
                                <option value="email" {% if sort == 'email' %}selected{% endif %}>Email</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2 align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa fa-filter me-1"></i>Filter
                            </button>
                            <a href="{{ path('app_admin_users') }}" class="btn btn-secondary">
                                <i class="fa fa-redo"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Users Table -->
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if users|length > 0 %}
                                {% for user in users %}
                                    <tr>
                                        <td>
                                            <small class="text-muted">#{{ user.id }}</small>
                                        </td>
                                        <td>
                                            <strong>{{ user.prenom }} {{ user.nom }}</strong>
                                        </td>
                                        <td>
                                            <small>{{ user.email }}</small>
                                        </td>
                                        <td>
                                            {% if user.role == 'admin' %}
                                                <span class="badge bg-danger">Admin</span>
                                            {% elseif user.role == 'client' %}
                                                <span class="badge bg-primary">Client</span>
                                            {% else %}
                                                <span class="badge bg-secondary">{{ user.role }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <small>{{ user.telephone ?? 'N/A' }}</small>
                                        </td>
                                        <td>
                                            {% if user.statutCompte == 'ACTIF' or user.statutCompte == 'actif' or user.phoneVerified %}
                                                <span class="badge bg-success">Active</span>
                                            {% else %}
                                                <span class="badge bg-warning">Inactive</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="{{ path('app_profile') }}" class="btn btn-outline-info" title="View">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                                <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}" class="btn btn-outline-warning" title="Edit">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <button class="btn btn-outline-danger" title="Delete" disabled>
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="fa fa-inbox me-2"></i>No users found
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
