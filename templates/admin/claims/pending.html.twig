{% extends 'base_admin.html.twig' %}

{% block title %}Pending Claims for Review{% endblock %}

{% block content %}
<div class="container mt-5">
    <h1>Insurance Claim Review Dashboard</h1>
    <p class="text-muted">Admin review queue based on analyzed pending claims.</p>

    {% if analyses|length > 0 %}
        <div class="alert alert-info">
            <strong>{{ analyses|length }}</strong> analyzed claim(s) pending review
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Claim ID</th>
                        <th>Insurance Type</th>
                        <th>Affected Area</th>
                        <th>Severity</th>
                        <th>Estimated Cost</th>
                        <th>Status</th>
                        <th>Analyzed</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for analysis in analyses %}
                        <tr>
                            <td>#{{ analysis.sinistre.id }}</td>
                            <td>
                                <span class="badge bg-primary">{{ analysis.sinistre.contrat.assurance.typeAssurance ?? 'N/A' }}</span>
                            </td>
                            <td>{{ analysis.affectedAreaPercentage }}%</td>
                            <td>
                                {% if analysis.severity == 'MAJOR' %}
                                    <span class="badge bg-danger">MAJOR</span>
                                {% elseif analysis.severity == 'MEDIUM' %}
                                    <span class="badge bg-warning text-dark">MEDIUM</span>
                                {% else %}
                                    <span class="badge bg-success">MINOR</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if analysis.estimatedCost %}
                                    ${{ analysis.estimatedCost|number_format(0) }}
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>
                            <td>
                                {% if analysis.sinistre.statut == 'EN_ATTENTE' %}
                                    <span class="badge bg-warning text-dark">Pending</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ analysis.sinistre.statut }}</span>
                                {% endif %}
                            </td>
                            <td>{{ analysis.analyzedAt|date('Y-m-d H:i') }}</td>
                            <td>
                                <a href="{{ path('admin_claims_detail', {id: analysis.id}) }}" class="btn btn-sm btn-info">Review</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-success">
            <strong>All caught up!</strong> No analyzed pending claims for review.
        </div>
    {% endif %}
</div>
{% endblock %}
