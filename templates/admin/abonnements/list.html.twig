{% extends 'base_admin.html.twig' %}

{% block title %}Manage Subscription Plans - Admin Dashboard{% endblock %}

{% block content %}
<div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
    <div class="container">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h2 class="mb-0">
                    <i class="fa fa-cube me-2"></i>Subscription Plans
                </h2>
                <small class="text-muted">Manage subscription plans for your platform</small>
            </div>
            <div class="col-md-6 text-end">
                <a href="{{ path('app_admin_abonnement_new') }}" class="btn btn-primary">
                    <i class="fa fa-plus me-2"></i>Create New Plan
                </a>
            </div>
        </div>

        <!-- Plans Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                {% if abonnements|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%;">Plan Name</th>
                                    <th style="width: 12%;">Monthly</th>
                                    <th style="width: 12%;">Annual</th>
                                    <th style="width: 10%;">Duration</th>
                                    <th style="width: 15%;">Description</th>
                                    <th style="width: 10%;">Status</th>
                                    <th style="width: 26%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for abonnement in abonnements %}
                                    <tr>
                                        <td>
                                            <strong>{{ abonnement.nomAbonnement }}</strong>
                                        </td>
                                        <td>
                                            <span class="text-success fw-bold">${{ abonnement.prixMensuel|number_format(2) }}</span>
                                        </td>
                                        <td>
                                            <span>${{ abonnement.prixAnnuel|number_format(2) }}</span>
                                        </td>
                                        <td>
                                            <small class="badge bg-info">{{ abonnement.duree }}</small>
                                        </td>
                                        <td>
                                            <small>{{ abonnement.description[:50]|default('No description') }}...</small>
                                        </td>
                                        <td>
                                            {% if abonnement.actif %}
                                                <span class="badge bg-success">Active</span>
                                            {% else %}
                                                <span class="badge bg-danger">Inactive</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('app_admin_abonnement_edit', {'id': abonnement.idAbonnement}) }}" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a href="{{ path('app_admin_abonnement_delete', {'id': abonnement.idAbonnement}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')" title="Delete">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                            <a href="{{ path('app_admin_client_subscriptions') }}" class="btn btn-sm btn-info" title="View Subscribers">
                                                <i class="fa fa-users"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="alert alert-info border-0 mb-0">
                        <i class="fa fa-info-circle me-2"></i>
                        No subscription plans created yet.
                        <a href="{{ path('app_admin_abonnement_new') }}" class="alert-link">Create one now</a>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Reclamations Section -->
        <div class="card border-0 shadow-sm mt-5">
            <div class="card-header bg-light border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fa fa-exclamation-circle me-2 text-warning"></i>Reclamations
                    </h5>
                    <span class="badge bg-warning text-dark">{{ reclamations|length }}</span>
                </div>
            </div>
            <div class="card-body">
                {% if reclamations|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%;">ID</th>
                                    <th style="width: 20%;">Subject</th>
                                    <th style="width: 15%;">From User</th>
                                    <th style="width: 12%;">Category</th>
                                    <th style="width: 12%;">Plan</th>
                                    <th style="width: 10%;">Status</th>
                                    <th style="width: 10%;">Date</th>
                                    <th style="width: 16%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reclamation in reclamations %}
                                    <tr>
                                        <td>
                                            <strong>#{{ reclamation.id }}</strong>
                                        </td>
                                        <td>
                                            <strong>{{ reclamation.subject }}</strong>
                                        </td>
                                        <td>
                                            {{ reclamation.user.email }}<br>
                                            <small class="text-muted">{{ reclamation.user.nom }}</small>
                                        </td>
                                        <td>
                                            <span class="badge 
                                                {% if reclamation.category == 'billing' %}bg-danger
                                                {% elseif reclamation.category == 'technical' %}bg-info
                                                {% elseif reclamation.category == 'service' %}bg-warning text-dark
                                                {% else %}bg-secondary{% endif %}">
                                                {{ reclamation.category|capitalize }}
                                            </span>
                                        </td>
                                        <td>
                                            {% if reclamation.abonnement %}
                                                <span class="badge bg-info">{{ reclamation.abonnement.nomAbonnement }}</span>
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge 
                                                {% if reclamation.status == 'pending' %}bg-warning text-dark
                                                {% elseif reclamation.status == 'in_progress' %}bg-info
                                                {% elseif reclamation.status == 'resolved' %}bg-success
                                                {% else %}bg-secondary{% endif %}">
                                                {{ reclamation.status|capitalize }}
                                            </span>
                                        </td>
                                        <td>
                                            <small>{{ reclamation.createdAt|date('M d, Y') }}</small>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#reclamationModal{{ reclamation.id }}" title="View Details">
                                                <i class="fa fa-eye"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#responseModal{{ reclamation.id }}" title="Respond">
                                                <i class="fa fa-reply"></i>
                                            </button>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Detail Modals -->
                    {% for reclamation in reclamations %}
                        <!-- View Details Modal -->
                        <div class="modal fade" id="reclamationModal{{ reclamation.id }}" tabindex="-1">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Reclamation #{{ reclamation.id }}</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label text-muted">Subject</label>
                                                <p class="fw-bold">{{ reclamation.subject }}</p>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label text-muted">Category</label>
                                                <p class="fw-bold">{{ reclamation.category|capitalize }}</p>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label text-muted">From</label>
                                                <p class="fw-bold">{{ reclamation.user.email }}</p>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label text-muted">Status</label>
                                                <p class="fw-bold">{{ reclamation.status|capitalize }}</p>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label text-muted">Related Plan</label>
                                                <p class="fw-bold">{{ reclamation.abonnement ? reclamation.abonnement.nomAbonnement : 'None' }}</p>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label text-muted">Date Submitted</label>
                                                <p class="fw-bold">{{ reclamation.createdAt|date('M d, Y H:i') }}</p>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label text-muted">Description</label>
                                            <div class="border rounded p-3 bg-light">
                                                <p style="white-space: pre-wrap;">{{ reclamation.description }}</p>
                                            </div>
                                        </div>
                                        {% if reclamation.adminResponse %}
                                        <div class="mb-3">
                                            <label class="form-label text-muted">Admin Response</label>
                                            <div class="border rounded p-3 bg-info-light">
                                                <p style="white-space: pre-wrap;">{{ reclamation.adminResponse }}</p>
                                            </div>
                                        </div>
                                        {% endif %}
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="alert alert-success border-0 mb-0">
                        <i class="fa fa-check-circle me-2"></i>
                        No reclamations at the moment. All is well!
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Quick Links -->
        <div class="row mt-4">
            <div class="col-md-6">
                <a href="{{ path('app_admin_client_subscriptions') }}" class="btn btn-outline-primary w-100">
                    <i class="fa fa-users me-2"></i>View Client Subscriptions
                </a>
            </div>
            <div class="col-md-6">
                <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary w-100">
                    <i class="fa fa-arrow-left me-2"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
