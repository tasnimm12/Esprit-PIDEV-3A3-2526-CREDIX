{% extends 'base_admin.html.twig' %}

{% block title %}Manage Subscription Plans - Admin Dashboard{% endblock %}

{% block content %}
<div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
    <div class="container">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h2 class="mb-0">
                    <i class="fa fa-cube me-2"></i>Subscription Plans
                </h2>
                <small class="text-muted">Manage subscription plans for your platform</small>
            </div>
            <div class="col-md-6 text-end">
                <a href="{{ path('app_admin_abonnement_new') }}" class="btn btn-primary">
                    <i class="fa fa-plus me-2"></i>Create New Plan
                </a>
            </div>
        </div>

        <!-- Plans Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                {% if abonnements|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%;">Plan Name</th>
                                    <th style="width: 12%;">Monthly</th>
                                    <th style="width: 12%;">Annual</th>
                                    <th style="width: 10%;">Duration</th>
                                    <th style="width: 15%;">Description</th>
                                    <th style="width: 10%;">Status</th>
                                    <th style="width: 26%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for abonnement in abonnements %}
                                    <tr>
                                        <td>
                                            <strong>{{ abonnement.nomAbonnement }}</strong>
                                        </td>
                                        <td>
                                            <span class="text-success fw-bold">${{ abonnement.prixMensuel|number_format(2) }}</span>
                                        </td>
                                        <td>
                                            <span>${{ abonnement.prixAnnuel|number_format(2) }}</span>
                                        </td>
                                        <td>
                                            <small class="badge bg-info">{{ abonnement.duree }}</small>
                                        </td>
                                        <td>
                                            <small>{{ abonnement.description[:50]|default('No description') }}...</small>
                                        </td>
                                        <td>
                                            {% if abonnement.actif %}
                                                <span class="badge bg-success">Active</span>
                                            {% else %}
                                                <span class="badge bg-danger">Inactive</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('app_admin_abonnement_edit', {'id': abonnement.idAbonnement}) }}" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a href="{{ path('app_admin_abonnement_delete', {'id': abonnement.idAbonnement}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')" title="Delete">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                            <a href="{{ path('app_admin_client_subscriptions') }}" class="btn btn-sm btn-info" title="View Subscribers">
                                                <i class="fa fa-users"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="alert alert-info border-0 mb-0">
                        <i class="fa fa-info-circle me-2"></i>
                        No subscription plans created yet.
                        <a href="{{ path('app_admin_abonnement_new') }}" class="alert-link">Create one now</a>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Quick Links -->
        <div class="row mt-4">
            <div class="col-md-6">
                <a href="{{ path('app_admin_client_subscriptions') }}" class="btn btn-outline-primary w-100">
                    <i class="fa fa-users me-2"></i>View Client Subscriptions
                </a>
            </div>
            <div class="col-md-6">
                <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary w-100">
                    <i class="fa fa-arrow-left me-2"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
