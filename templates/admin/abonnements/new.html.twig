{% extends 'base_admin.html.twig' %}

{% block title %}Create Subscription Plan - Admin Dashboard{% endblock %}

{% block content %}
<div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
    <div class="container">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-md-8 mx-auto">
                <h2 class="mb-0">
                    <i class="fa fa-plus me-2"></i>Create New Subscription Plan
                </h2>
                <small class="text-muted">Add a new plan to your subscription offerings</small>
            </div>
        </div>

        <!-- Error Messages -->
        {% if app.flashes %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type === 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        {% endif %}

        {% if errors is defined and errors|length > 0 %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0">
                        <i class="fas fa-exclamation-circle me-2" style="margin-top: 2px;"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="alert-heading mb-2">
                            <i class="fa fa-times-circle me-2"></i>Validation Errors
                        </h5>
                        <ul class="mb-0">
                            {% for error in errors %}
                                <li class="mb-1">{{ error }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endif %}

        <!-- Form -->
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <form method="POST" action="{{ path('app_admin_abonnement_new') }}">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Plan Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="type_abonnement" placeholder="e.g., Basic, Premium, Enterprise" value="{{ form_data.type_abonnement|default('') }}">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Duration</label>
                                    <select class="form-control" name="duree">
                                        <option value="">Select Duration</option>
                                        <option value="1 month" {% if form_data.duree|default('') == '1 month' %}selected{% endif %}>1 Month</option>
                                        <option value="3 months" {% if form_data.duree|default('') == '3 months' %}selected{% endif %}>3 Months</option>
                                        <option value="6 months" {% if form_data.duree|default('') == '6 months' %}selected{% endif %}>6 Months</option>
                                        <option value="1 year" {% if form_data.duree|default('') == '1 year' %}selected{% endif %}>1 Year</option>
                                        <option value="Lifetime" {% if form_data.duree|default('') == 'Lifetime' %}selected{% endif %}>Lifetime</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Monthly Price <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" step="0.01" class="form-control" name="prix_mensuel" placeholder="0.00" value="{{ form_data.prix_mensuel|default('') }}">
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Annual Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" step="0.01" class="form-control" name="prix_annuel" placeholder="0.00" value="{{ form_data.prix_annuel|default('') }}">
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Description</label>
                                <textarea class="form-control" name="description" rows="3" placeholder="Describe this plan...">{{ form_data.description|default('') }}</textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Features/Advantages</label>
                                <textarea class="form-control" name="avantages" rows="3" placeholder="List features separated by commas or new lines...">{{ form_data.avantages|default('') }}</textarea>
                            </div>

                            <div class="mb-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="actif" value="1" id="planActive" {% if form_data.actif|default(true) %}checked{% endif %}>
                                    <label class="form-check-label" for="planActive">
                                        <strong>Active (visible to clients)</strong>
                                    </label>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fa fa-save me-2"></i>Create Plan
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <a href="{{ path('app_admin_abonnements') }}" class="btn btn-outline-secondary w-100">
                                        <i class="fa fa-times me-2"></i>Cancel
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
