{% extends 'base_admin.html.twig' %}

{% block title %}Client Subscriptions - Admin Dashboard{% endblock %}

{% block content %}
<div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
    <div class="container">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h2 class="mb-0">
                    <i class="fa fa-users me-2"></i>Client Subscriptions
                </h2>
                <small class="text-muted">View and manage all client subscriptions</small>
            </div>
            <div class="col-md-6 text-end">
                <a href="{{ path('app_admin_client_subscriptions') }}" class="btn btn-sm btn-outline-primary">
                    <i class="fa fa-refresh me-1"></i>Refresh
                </a>
            </div>
        </div>

        <!-- Subscriptions Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                {% if clients|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 20%;">Client Email</th>
                                    <th style="width: 20%;">Client Name</th>
                                    <th style="width: 30%;">Active Plans</th>
                                    <th style="width: 30%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for client in clients %}
                                    <tr>
                                        <td>
                                            <small class="text-monospace">{{ client.email }}</small>
                                        </td>
                                        <td>
                                            <strong>{{ client.prenom }} {{ client.nom }}</strong>
                                        </td>
                                        <td>
                                            {% if client.abonnements|length > 0 %}
                                                <div class="d-flex flex-wrap gap-2">
                                                    {% for abonnement in client.abonnements %}
                                                        <span class="badge bg-success">
                                                            {{ abonnement.nomAbonnement }}
                                                            <small class="ms-1">${{ abonnement.prixMensuel|number_format(2) }}/mo</small>
                                                        </span>
                                                    {% endfor %}
                                                </div>
                                            {% else %}
                                                <span class="badge bg-secondary">
                                                    No Subscriptions
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('app_admin_set_client_subscription', {'userId': client.id}) }}" class="btn btn-sm btn-primary" title="Manage Subscriptions">
                                                <i class="fa fa-edit"></i> Manage
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Summary -->
                    <div class="row mt-4 pt-3 border-top">
                        <div class="col-md-3 text-center">
                            <div>
                                <h4 class="text-primary mb-0">{{ clients|length }}</h4>
                                <small class="text-muted">Total Clients</small>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div>
                                <h4 class="text-success mb-0">{{ clients|filter(c => c.abonnements|length > 0)|length }}</h4>
                                <small class="text-muted">With Subscriptions</small>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div>
                                <h4 class="text-warning mb-0">{{ clients|filter(c => c.abonnements|length == 0)|length }}</h4>
                                <small class="text-muted">No Subscriptions</small>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div>
                                <h4 class="text-info mb-0">
                                    {% set total = 0 %}
                                    {% for client in clients %}
                                        {% set total = total + client.abonnements|length %}
                                    {% endfor %}
                                    {{ total }}
                                </h4>
                                <small class="text-muted">Total Subscriptions</small>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-info border-0 mb-0">
                        <i class="fa fa-info-circle me-2"></i>
                        No clients found.
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Navigation -->
        <div class="row mt-4">
            <div class="col-md-6">
                <a href="{{ path('app_admin_abonnements') }}" class="btn btn-outline-primary w-100">
                    <i class="fa fa-cube me-2"></i>Manage Plans
                </a>
            </div>
            <div class="col-md-6">
                <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary w-100">
                    <i class="fa fa-arrow-left me-2"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
