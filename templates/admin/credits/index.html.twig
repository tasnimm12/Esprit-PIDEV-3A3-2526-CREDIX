{% extends 'base_admin.html.twig' %}

{% block title %}Manage Credits - Admin{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Credit Management</h1>
        <a href="{{ path('app_admin_credit_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Credit
        </a>
    </div>

    {% if app.flashes %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    <!-- Search & Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="GET" class="row g-3">
                <div class="col-md-6">
                    <input type="text" name="search" class="form-control" placeholder="Search by email or name..." value="{{ search }}">
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Status</option>
                        {% for creditStatus in creditStatuses %}
                            <option value="{{ creditStatus }}" {% if status == creditStatus %}selected{% endif %}>
                                {{ creditStatus|replace({'_': ' '}) }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-secondary w-100">
                        <i class="fas fa-search"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Credits Table -->
    {% if credits is empty %}
        <div class="alert alert-info">
            <strong>No credits found.</strong>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>User</th>
                        <th>Amount</th>
                        <th>Type</th>
                        <th>Interest</th>
                        <th>Discount</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for credit in credits %}
                        <tr>
                            <td>{{ credit.getDateDemande()|date('d/m/Y') }}</td>
                            <td>
                                {{ credit.getUtilisateur().getPrenom() }} {{ credit.getUtilisateur().getNom() }}
                                <br>
                                <small class="text-muted">{{ credit.getUtilisateur().getEmail() }}</small>
                            </td>
                            <td>${{ credit.getMontantDemande()|number_format(2, '.', ',') }}</td>
                            <td>{{ credit.getTypeCredit() }}</td>
                            <td>{{ credit.getTauxInteret()|number_format(2) }}%</td>
                            <td>
                                {% if credit.getReductionPourcentage() %}
                                    <span class="badge bg-success">{{ credit.getReductionPourcentage()|number_format(1) }}%</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>${{ credit.getMontantTotal()|number_format(2, '.', ',') }}</td>
                            <td>
                                {% set statusClass = credit.getStatutCredit() == 'ACCEPTE' ? 'success' : (credit.getStatutCredit() == 'REFUSE' ? 'danger' : (credit.getStatutCredit() == 'EN_ATTENTE' ? 'warning' : (credit.getStatutCredit() == 'TERMINE' ? 'secondary' : 'info'))) %}
                                <span class="badge bg-{{ statusClass }}">{{ credit.getStatutCredit()|replace({'_': ' '}) }}</span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('app_admin_credit_view', {id: credit.getIdCredit()}) }}" class="btn btn-info" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_admin_credit_edit', {id: credit.getIdCredit()}) }}" class="btn btn-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    {% if credit.getStatutCredit() == 'EN_ATTENTE' %}
                                        <button type="button" class="btn btn-success" title="Accept" onclick="acceptCredit({{ credit.getIdCredit() }})">
                                            <i class="fas fa-check"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger" title="Deny" onclick="denyCredit({{ credit.getIdCredit() }})">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    {% endif %}
                                    <button type="button" class="btn btn-danger" title="Delete" onclick="deleteCredit({{ credit.getIdCredit() }})">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<!-- Accept Credit Modal -->
<div class="modal fade" id="acceptModal" tabindex="-1" aria-labelledby="acceptModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="acceptModalLabel">Accept Credit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to accept this credit application?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="acceptForm" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-success">Accept</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Deny Credit Modal -->
<div class="modal fade" id="denyModal" tabindex="-1" aria-labelledby="denyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="denyModalLabel">Deny Credit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="denyForm" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="motif_refus" class="form-label">Reason for Denial</label>
                        <textarea class="form-control" id="motif_refus" name="motif_refus" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Deny</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Credit Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Credit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger" role="alert">
                    <strong>Warning!</strong> This action cannot be undone. Are you sure you want to delete this credit?
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function acceptCredit(creditId) {
    const form = document.getElementById('acceptForm');
    form.action = '{{ path('app_admin_credit_accept', {id: 'CREDIT_ID'}) }}'.replace('CREDIT_ID', creditId);
    const modal = new bootstrap.Modal(document.getElementById('acceptModal'));
    modal.show();
}

function denyCredit(creditId) {
    const form = document.getElementById('denyForm');
    form.action = '{{ path('app_admin_credit_deny', {id: 'CREDIT_ID'}) }}'.replace('CREDIT_ID', creditId);
    const modal = new bootstrap.Modal(document.getElementById('denyModal'));
    modal.show();
}

function deleteCredit(creditId) {
    const form = document.getElementById('deleteForm');
    form.action = '{{ path('app_admin_credit_delete', {id: 'CREDIT_ID'}) }}'.replace('CREDIT_ID', creditId);
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    modal.show();
}
</script>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
    
    .badge {
        padding: 0.4rem 0.8rem;
        font-size: 0.85rem;
    }
</style>
{% endblock %}
