{% extends 'base_admin.html.twig' %}

{% block title %}Credit Details - Admin{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Credit #{{ credit.getIdCredit() }}</h1>
                <a href="{{ path('app_admin_credits') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="mb-0">Credit Information</h5>
                        </div>
                        <div class="col-md-6 text-end">
                            {% set statusClass = credit.getStatutCredit() == 'ACCEPTE' ? 'success' : (credit.getStatutCredit() == 'REFUSE' ? 'danger' : (credit.getStatutCredit() == 'EN_ATTENTE' ? 'warning' : (credit.getStatutCredit() == 'TERMINE' ? 'secondary' : 'info'))) %}
                            <span class="badge bg-{{ statusClass }} p-2">{{ credit.getStatutCredit()|replace({'_': ' '}) }}</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- User Information -->
                    <h6 class="mb-3 font-weight-bold">Applicant Information</h6>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="text-muted small">Name</label>
                            <p>{{ credit.getUtilisateur().getPrenom() }} {{ credit.getUtilisateur().getNom() }}</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Email</label>
                            <p>{{ credit.getUtilisateur().getEmail() }}</p>
                        </div>
                    </div>

                    <!-- Credit Details -->
                    <hr>
                    <h6 class="mb-3 font-weight-bold">Credit Details</h6>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Amount Requested</label>
                            <p class="lead">${{ credit.getMontantDemande()|number_format(2, '.', ',') }}</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Credit Type</label>
                            <p class="lead">{{ credit.getTypeCredit() }}</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="text-muted small">Base Interest Rate</label>
                            <p>{{ credit.getTauxInteret()|number_format(2) }}%</p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small">Subscription Discount</label>
                            <p>
                                {% if credit.getReductionPourcentage() %}
                                    <span class="badge bg-success">{{ credit.getReductionPourcentage()|number_format(1) }}%</span>
                                {% else %}
                                    <span class="text-muted">None</span>
                                {% endif %}
                            </p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small">Final Interest Rate</label>
                            <p>{{ (credit.getTauxInteret() - (credit.getReductionPourcentage() ?? 0))|number_format(2) }}%</p>
                        </div>
                    </div>

                    <!-- Payment Information -->
                    <hr>
                    <h6 class="mb-3 font-weight-bold">Payment Information</h6>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Monthly Payment</label>
                            <p class="lead text-success">${{ credit.getMensualite()|number_format(2, '.', ',') }}</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Total Amount</label>
                            <p class="lead">${{ credit.getMontantTotal()|number_format(2, '.', ',') }}</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Amount Remaining</label>
                            <p>${{ credit.getMontantRestant()|number_format(2, '.', ',') }}</p>
                        </div>
                    </div>

                    <!-- Bank Account -->
                    <hr>
                    <h6 class="mb-3 font-weight-bold">Bank Account</h6>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="text-muted small">Account Type</label>
                            <p>{{ credit.getCompte().getTypeCompte() }}</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Account Number</label>
                            <p>{{ credit.getCompte().getNumeroCompte() }}</p>
                        </div>
                    </div>

                    <!-- Timeline -->
                    <hr>
                    <h6 class="mb-3 font-weight-bold">Timeline</h6>

                    <div class="row">
                        <div class="col-md-4">
                            <label class="text-muted small">Application Date</label>
                            <p>{{ credit.getDateDemande()|date('d/m/Y H:i') }}</p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small">Start Date</label>
                            <p>
                                {% if credit.getDateDebut() %}
                                    {{ credit.getDateDebut()|date('d/m/Y') }}
                                {% else %}
                                    <span class="text-muted">Pending</span>
                                {% endif %}
                            </p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small">End Date</label>
                            <p>
                                {% if credit.getDateFin() %}
                                    {{ credit.getDateFin()|date('d/m/Y') }}
                                {% else %}
                                    <span class="text-muted">Pending</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    <!-- Subscription Info -->
                    {% if credit.getAbonnement() %}
                        <hr>
                        <h6 class="mb-3 font-weight-bold">Subscription Information</h6>

                        <div class="row">
                            <div class="col-md-6">
                                <label class="text-muted small">Subscription Type</label>
                                <p>{{ credit.getAbonnement().getTypeAbonnement() }}</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Discount Applied</label>
                                <p><span class="badge bg-info">{{ credit.getAbonnement().getReductionPourcentage() ?? 0 }}%</span></p>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Refusal Reason -->
                    {% if credit.getStatutCredit() == 'REFUSE' and credit.getMotifRefus() %}
                        <hr>
                        <div class="alert alert-danger" role="alert">
                            <h6 class="alert-heading">Reason for Rejection</h6>
                            <p class="mb-0">{{ credit.getMotifRefus() }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 d-flex gap-2">
                <a href="{{ path('app_admin_credit_edit', {id: credit.getIdCredit()}) }}" class="btn btn-warning btn-lg">
                    <i class="fas fa-edit"></i> Edit
                </a>
                {% if credit.getStatutCredit() == 'EN_ATTENTE' %}
                    <form method="POST" action="{{ path('app_admin_credit_accept', {id: credit.getIdCredit()}) }}" style="display: inline;">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-check"></i> Accept
                        </button>
                    </form>
                    <button type="button" class="btn btn-danger btn-lg" onclick="showDenyModal()">
                        <i class="fas fa-times"></i> Deny
                    </button>
                {% endif %}
                <a href="{{ path('app_admin_credits') }}" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Deny Modal -->
<div class="modal fade" id="denyModal" tabindex="-1" aria-labelledby="denyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="denyModalLabel">Deny Credit Application</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" action="{{ path('app_admin_credit_deny', {id: credit.getIdCredit()}) }}">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="motif_refus" class="form-label">Reason for Denial</label>
                        <textarea class="form-control" id="motif_refus" name="motif_refus" rows="3" placeholder="Enter the reason for denial..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Deny Application</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function showDenyModal() {
    const modal = new bootstrap.Modal(document.getElementById('denyModal'));
    modal.show();
}
</script>

<style>
    .lead {
        font-size: 1.25rem;
        font-weight: 500;
    }
    
    .badge {
        padding: 0.5rem 1rem;
        font-weight: 500;
    }
    
    .text-muted {
        color: #6c757d;
    }
</style>
{% endblock %}
