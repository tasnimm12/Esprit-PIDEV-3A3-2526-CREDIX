{% extends 'base_admin.html.twig' %}

{% block title %}Bank Accounts - Admin{% endblock %}

{% block breadcrumb_current %}Bank Accounts{% endblock %}

{% block content %}
<div class="container-fluid mt-5 pt-3">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="bi bi-bank2"></i> Bank Accounts Management
                </h2>
                <a href="{{ path('app_admin_bank_account_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add New Account
                </a>
            </div>
        </div>
    </div>

    {# Flash Messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Filter Section #}
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form method="GET" class="row g-3">
                        <div class="col-md-5">
                            <label for="emailFilter" class="form-label">Filter by User Email</label>
                            <input type="text" class="form-control" id="emailFilter" name="email" 
                                   placeholder="Enter user email..." value="{{ emailFilter }}">
                        </div>

                        <div class="col-md-3">
                            <label for="statusFilter" class="form-label">Status</label>
                            <select class="form-select" id="statusFilter" name="status">
                                <option value="">All Statuses</option>
                                <option value="1" {% if statusFilter == '1' %}selected{% endif %}>Active</option>
                                <option value="0" {% if statusFilter == '0' %}selected{% endif %}>Inactive</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label for="sortBy" class="form-label">Sort By</label>
                            <select class="form-select" id="sortBy" name="sort">
                                <option value="id" {% if sort == 'id' %}selected{% endif %}>ID</option>
                                <option value="titulaire" {% if sort == 'titulaire' %}selected{% endif %}>Holder</option>
                                <option value="solde" {% if sort == 'solde' %}selected{% endif %}>Balance</option>
                            </select>
                        </div>

                        <div class="col-md-2 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-outline-primary flex-grow-1">
                                <i class="bi bi-search"></i> Search
                            </button>
                            <a href="{{ path('app_admin_bank_accounts') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {# Active Filters Display #}
    {% if emailFilter or statusFilter != '' %}
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="d-flex flex-wrap gap-2">
                    {% if emailFilter %}
                        <span class="badge bg-info text-dark">
                            Email: {{ emailFilter }}
                        </span>
                    {% endif %}
                    {% if statusFilter != '' %}
                        <span class="badge bg-info text-dark">
                            Status: {% if statusFilter == '1' %}Active{% else %}Inactive{% endif %}
                        </span>
                    {% endif %}
                    <a href="{{ path('app_admin_bank_accounts') }}" class="badge bg-secondary text-decoration-none">
                        Clear Filters
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    {# Bank Accounts Table #}
    <div class="row">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    {% if bankAccounts|length > 0 %}
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-muted small">
                                        <a href="?email={{ emailFilter }}&status={{ statusFilter }}&sort=id&order={% if sort == 'id' and order == 'DESC' %}ASC{% else %}DESC{% endif %}">
                                            ID {% if sort == 'id' %}<i class="bi bi-arrow-down"></i>{% endif %}
                                        </a>
                                    </th>
                                    <th class="text-muted small">
                                        <a href="?email={{ emailFilter }}&status={{ statusFilter }}&sort=titulaire&order={% if sort == 'titulaire' and order == 'DESC' %}ASC{% else %}DESC{% endif %}">
                                            Account Holder {% if sort == 'titulaire' %}<i class="bi bi-arrow-down"></i>{% endif %}
                                        </a>
                                    </th>
                                    <th class="text-muted small">User Email</th>
                                    <th class="text-muted small">Account Number</th>
                                    <th class="text-muted small">
                                        <a href="?email={{ emailFilter }}&status={{ statusFilter }}&sort=solde&order={% if sort == 'solde' and order == 'DESC' %}ASC{% else %}DESC{% endif %}">
                                            Balance {% if sort == 'solde' %}<i class="bi bi-arrow-down"></i>{% endif %}
                                        </a>
                                    </th>
                                    <th class="text-muted small">Account Type</th>
                                    <th class="text-muted small">Status</th>
                                    <th class="text-muted small">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for account in bankAccounts %}
                                    <tr>
                                        <td><strong>#{{ account.id }}</strong></td>
                                        <td>{{ account.titulaire }}</td>
                                        <td>{{ account.utilisateur.email }}</td>
                                        <td>
                                            <code>****{{ account.numeroCompte|slice(-4) }}</code>
                                        </td>
                                        <td>
                                            <strong>{{ account.solde|number_format(2) }} {{ account.devise }}</strong>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">{{ account.typeCompte }}</span>
                                        </td>
                                        <td>
                                            {% if account.actif %}
                                                <span class="badge bg-success">Active</span>
                                            {% else %}
                                                <span class="badge bg-secondary">Inactive</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="{{ path('app_admin_bank_account_edit', {id: account.id}) }}" 
                                                   class="btn btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="{{ path('app_admin_bank_account_delete', {id: account.id}) }}" 
                                                   class="btn btn-outline-danger" 
                                                   onclick="return confirm('Are you sure you want to delete this account?');"
                                                   title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <div class="card-body text-center text-muted py-5">
                            <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                            <p class="mt-3">No bank accounts found</p>
                            <a href="{{ path('app_admin_bank_account_new') }}" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus-circle"></i> Create First Account
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    table th a {
        color: inherit;
        text-decoration: none;
        cursor: pointer;
    }
    table th a:hover {
        color: #0d6efd;
    }
    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }
</style>
{% endblock %}
