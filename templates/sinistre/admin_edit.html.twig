{% extends 'base_admin.html.twig' %}

{% block title %}{{ title }} - Admin{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="fas fa-edit"></i> {{ title }} - Claim #{{ sinistre.id }}</h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('app_sinistre_show', {id: sinistre.id}) }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Claim
            </a>
        </div>
    </div>

    <!-- Alerts -->
    {% if app.flashes %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type === 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    {% if errors|length > 0 %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Errors:</strong>
            {% for error in errors %}
                <div>{{ error }}</div>
            {% endfor %}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-8">
            <!-- Claim Edit Form -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Edit Claim Information</h5>
                </div>
                <div class="card-body">
                    <form method="POST">
                        <div class="mb-3">
                            <label for="contrat_id" class="form-label"><strong>Contract</strong></label>
                            <select class="form-control" id="contrat_id" name="contrat_id" disabled>
                                <option value="{{ sinistre.contrat.id }}" selected>
                                    {{ sinistre.contrat.numeroContrat }} - {{ sinistre.contrat.assurance.typeAssurance }}
                                </option>
                            </select>
                            <small class="form-text text-muted">Cannot change contract after creation</small>
                        </div>

                        <div class="mb-3">
                            <label for="date_sinistre" class="form-label"><strong>Date of Incident *</strong></label>
                            <input type="date" class="form-control" id="date_sinistre" name="date_sinistre" 
                                value="{{ sinistre.dateSinistre|date('Y-m-d') }}" 
                                placeholder="Sélectionner la date du sinistre">
                            <small class="form-text text-muted">Date cannot be in the future</small>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label"><strong>Claim Description *</strong></label>
                            <textarea class="form-control" id="description" name="description" rows="6">{{ sinistre.description }}</textarea>
                            <small class="form-text text-muted">Detailed information about the claim</small>
                        </div>

                        <hr>

                        <!-- Admin Response Section -->
                        <div class="alert alert-info mb-3">
                            <strong><i class="fas fa-info-circle"></i> Admin Actions</strong><br>
                            <small>Change the status below and add your response message to notify the user</small>
                        </div>

                        <div class="mb-3">
                            <label for="statut" class="form-label"><strong>Claim Status *</strong></label>
                            <select class="form-control" id="statut" name="statut">
                                <option value="EN_ATTENTE" {% if sinistre.statut == 'EN_ATTENTE' %}selected{% endif %}>
                                    <i class="fas fa-clock"></i> Pending (No Action)
                                </option>
                                <option value="ACCEPTE" {% if sinistre.statut == 'ACCEPTE' %}selected{% endif %}>
                                    <i class="fas fa-check"></i> Approved
                                </option>
                                <option value="REJETE" {% if sinistre.statut == 'REJETE' %}selected{% endif %}>
                                    <i class="fas fa-times"></i> Rejected
                                </option>
                            </select>
                            <small class="form-text text-muted">Select a status to process this claim</small>
                        </div>

                        <div class="mb-3">
                            <label for="admin_reponse" class="form-label"><strong>Response Message to User</strong></label>
                            <textarea class="form-control" id="admin_reponse" name="admin_reponse" rows="4" placeholder="Enter your response message here...">{% if sinistre.adminReponse %}{{ sinistre.adminReponse }}{% endif %}</textarea>
                            <small class="form-text text-muted">This message will be shown to the user. Example: 'Your claim has been approved. Please contact us for further details.'</small>
                        </div>

                        <hr>

                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save & Process Claim
                            </button>
                            <a href="{{ path('app_sinistre_show', {id: sinistre.id}) }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Claim Summary</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted">Claim ID</small>
                        <h6 class="mb-0">#{{ sinistre.id }}</h6>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Current Status</small>
                        <h6 class="mb-0">
                            {% if sinistre.statut == 'EN_ATTENTE' %}
                                <span class="badge bg-warning text-dark">Pending</span>
                            {% elseif sinistre.statut == 'ACCEPTE' %}
                                <span class="badge bg-success">Accepted</span>
                            {% elseif sinistre.statut == 'REJETE' %}
                                <span class="badge bg-danger">Rejected</span>
                            {% endif %}
                        </h6>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <small class="text-muted">User</small>
                        <h6 class="mb-0">{{ sinistre.utilisateur.prenom }} {{ sinistre.utilisateur.nom }}</h6>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Email</small>
                        <p class="text-muted mb-0">
                            <a href="mailto:{{ sinistre.utilisateur.email }}">{{ sinistre.utilisateur.email }}</a>
                        </p>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <small class="text-muted">Filed Date</small>
                        <p class="text-muted mb-0">
                            <small>{{ sinistre.createdAt|date('d/m/Y H:i') }}</small>
                        </p>
                    </div>

                    <div class="alert alert-info">
                        <small>
                            <strong>Note:</strong> You can only edit pending claims. Once you approve or reject this claim, 
                            it will be locked from further edits.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
