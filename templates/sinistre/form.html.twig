{% extends 'base.html.twig' %}

{% block title %}{{ title }} - Credix{% endblock %}

{% block content %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<style>
    #map {
        width: 100%;
        height: 400px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
</style>

<div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="bg-white border rounded p-5 wow fadeInUp" data-wow-delay="0.1s">
                    <h1 class="display-5 mb-4">{{ title }}</h1>

                    <!-- Flash Messages -->
                    {% if app.flashes %}
                        {% for type, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ type in ['success', 'danger', 'warning', 'info'] ? type : 'secondary' }} alert-dismissible fade show" role="alert">
                                    {{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}
                    {% endif %}

                    {% include '_partials/validation_errors.html.twig' %}

                    <form method="POST" enctype="multipart/form-data" id="claimForm">
                        <div class="form-group mb-4">
                            <label for="contrat_id" class="form-label">Select Contract <span class="text-danger">*</span></label>
                            <select class="form-control" id="contrat_id" name="contrat_id" {% if isEdit|default(false) %}disabled{% endif %}>
                                <option value="">-- Choose a contract --</option>
                                {% for contract in contracts %}
                                    <option value="{{ contract.id }}" 
                                        {% if sinistre and sinistre.contrat.id == contract.id %}selected{% endif %}>
                                        {{ contract.numeroContrat }} - {{ contract.assurance.nomAssurance ?? 'N/A' }}
                                        (Status: {{ contract.statut }})
                                    </option>
                                {% endfor %}
                            </select>
                            <small class="form-text text-muted">Only active contracts are available</small>
                            <div class="invalid-feedback d-block" id="contratError"></div>
                        </div>

                        <div class="form-group mb-4">
                            <label for="date_sinistre" class="form-label">Date of Incident <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="date_sinistre" name="date_sinistre" 
                                value="{% if sinistre and sinistre.dateSinistre %}{{ sinistre.dateSinistre|date('Y-m-d') }}{% endif %}" 
                                placeholder="Sélectionner la date du sinistre">
                            <small class="form-text text-muted">The date cannot be in the future</small>
                            <div class="invalid-feedback d-block" id="dateError"></div>
                        </div>

                        <div class="form-group mb-4">
                            <label for="description" class="form-label">Claim Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="description" name="description" rows="6">{% if sinistre %}{{ sinistre.description }}{% endif %}</textarea>
                            <small class="form-text text-muted">Provide detailed information about the claim (10-5000 characters). The incident described here must match the selected insurance type.</small>
                            <div class="invalid-feedback d-block" id="descriptionError"></div>
                        </div>

                        <div class="form-group mb-4">
                            <label for="location_address" class="form-label">Incident Location <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="location_address" name="location_address" 
                                value="{% if sinistre and sinistre.locationAddress %}{{ sinistre.locationAddress }}{% endif %}"
                                placeholder="Enter the location or click on the map">
                            <small class="form-text text-muted">Click on the map below to pin the incident location</small>
                            <div class="invalid-feedback d-block" id="locationError"></div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label">Select Location on Map <span class="text-danger">*</span></label>
                            <div id="map" style="width: 100%; height: 400px; border: 1px solid #ddd; border-radius: 4px;"></div>
                            <small class="form-text text-muted">Click on the map to select the incident location. The marker position will be saved.</small>
                            <div class="invalid-feedback d-block" id="mapError"></div>
                        </div>

                        <input type="hidden" id="latitude" name="latitude" value="{% if sinistre and sinistre.latitude %}{{ sinistre.latitude }}{% else %}33.8869{% endif %}">
                        <input type="hidden" id="longitude" name="longitude" value="{% if sinistre and sinistre.longitude %}{{ sinistre.longitude }}{% else %}9.5375{% endif %}">

                        <div class="form-group mb-4">
                            <label for="preuves" class="form-label">Evidence / Supporting Documents</label>
                            <input type="file" class="form-control" id="preuves" name="preuves[]" multiple accept="image/*,.pdf,.doc,.docx">
                            <small class="form-text text-muted">Upload images, PDFs, or documents as evidence (Max 5 files, 25MB each). AI damage analysis is generated only for image files and appears on the claim details page after submission.</small>
                            <div class="invalid-feedback d-block" id="fileError"></div>
                        </div>

                        <div class="form-group mb-4">
                            <label for="signature" class="form-label">Your Signature <span class="text-danger">*</span></label>
                            <small class="form-text text-muted d-block mb-3">Please sign below to confirm the claim details. Click and drag to sign, then click 'Clear' to start over.</small>
                            <div style="border: 2px solid #ddd; border-radius: 4px; background-color: #f9f9f9;">
                                <canvas id="signatureCanvas" style="display: block; cursor: crosshair; width: 100%; height: 200px; background-color: white;"></canvas>
                            </div>
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="clearSignatureBtn">Clear Signature</button>
                            </div>
                            <input type="hidden" id="signature" name="signature" value="">
                            <div class="invalid-feedback d-block" id="signatureError"></div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <button type="submit" class="btn btn-primary w-100 py-3">
                                    {% if isEdit|default(false) %}
                                        Update Claim
                                    {% else %}
                                        File Claim
                                    {% endif %}
                                </button>
                            </div>
                            <div class="col-lg-6">
                                <a href="{% if isEdit|default(false) %}{{ path('app_sinistre_show', {id: sinistre.id}) }}{% else %}{{ path('app_sinistre_list') }}{% endif %}" class="btn btn-secondary w-100 py-3">
                                    Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const mapElement = document.getElementById('map');
        const latitudeInput = document.getElementById('latitude');
        const longitudeInput = document.getElementById('longitude');
        const locationAddressInput = document.getElementById('location_address');
        const mapError = document.getElementById('mapError');
        
        // Default to Tunisia center (Tunis)
        const defaultLat = parseFloat(latitudeInput.value) || 36.8065;
        const defaultLng = parseFloat(longitudeInput.value) || 10.1671;
        
        // Initialize Leaflet map
        const map = L.map(mapElement).setView([defaultLat, defaultLng], 13);
        
        // Add OpenStreetMap tiles
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors',
            maxZoom: 19
        }).addTo(map);
        
        // Create a marker for the selected location
        let marker = null;
        if (defaultLat && defaultLng) {
            marker = L.marker([defaultLat, defaultLng]).addTo(map);
            marker.bindPopup('Incident Location');
        }
        
        // Function to perform reverse geocoding using Nominatim
        function reverseGeocode(lat, lng) {
            const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`;
            
            fetch(url, {
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.address) {
                    const address = data.address;
                    // Build a comprehensive address
                    const parts = [];
                    
                    if (address.road) parts.push(address.road);
                    if (address.building) parts.push(address.building);
                    if (address.village) parts.push(address.village);
                    if (address.town) parts.push(address.town);
                    if (address.city) parts.push(address.city);
                    if (address.county) parts.push(address.county);
                    if (address.state) parts.push(address.state);
                    if (address.postcode) parts.push(address.postcode);
                    if (address.country) parts.push(address.country);
                    
                    const fullAddress = parts.join(', ');
                    locationAddressInput.value = fullAddress || `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
                    mapError.textContent = '';
                } else {
                    locationAddressInput.value = `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
                    mapError.textContent = '';
                }
            })
            .catch(error => {
                console.error('Nominatim error:', error);
                locationAddressInput.value = `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
                mapError.textContent = 'Could not retrieve address details';
            });
        }
        
        // Add forward geocoding with search box
        const searchInput = locationAddressInput;
        
        searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const query = searchInput.value.trim();
                
                if (!query) {
                    mapError.textContent = 'Please enter an address';
                    return;
                }
                
                // Use Nominatim for forward geocoding
                const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1`;
                
                fetch(url, {
                    headers: {
                        'Accept': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data && data.length > 0) {
                        const place = data[0];
                        const lat = parseFloat(place.lat);
                        const lng = parseFloat(place.lon);
                        
                        // Remove old marker
                        if (marker) {
                            map.removeLayer(marker);
                        }
                        
                        // Create new marker
                        marker = L.marker([lat, lng]).addTo(map);
                        marker.bindPopup(place.display_name).openPopup();
                        
                        // Update hidden fields
                        latitudeInput.value = lat;
                        longitudeInput.value = lng;
                        locationAddressInput.value = place.display_name;
                        mapError.textContent = '';
                        
                        // Center map on new location
                        map.setView([lat, lng], 15);
                    } else {
                        mapError.textContent = 'Address not found';
                    }
                })
                .catch(error => {
                    console.error('Search error:', error);
                    mapError.textContent = 'Could not search for address';
                });
            }
        });
        
        // Handle click on map to place marker
        map.on('click', function(e) {
            const lat = e.latlng.lat;
            const lng = e.latlng.lng;
            
            // Remove old marker
            if (marker) {
                map.removeLayer(marker);
            }
            
            // Create new marker at clicked location
            marker = L.marker([lat, lng]).addTo(map);
            marker.bindPopup(`Incident Location<br>${lat.toFixed(4)}, ${lng.toFixed(4)}`).openPopup();
            
            // Update hidden fields
            latitudeInput.value = lat;
            longitudeInput.value = lng;
            
            // Reverse geocode to get address
            reverseGeocode(lat, lng);
        });
        
        // Form submission validation
        const form = document.getElementById('claimForm');
        
        // Signature pad setup
        const canvas = document.getElementById('signatureCanvas');
        const signatureInput = document.getElementById('signature');
        const signatureError = document.getElementById('signatureError');
        const clearBtn = document.getElementById('clearSignatureBtn');
        
        if (canvas) {
            // Get device pixel ratio for better quality
            const ratio = Math.max(window.devicePixelRatio || 1, 1);
            const rect = canvas.getBoundingClientRect();
            
            canvas.width = rect.width * ratio;
            canvas.height = rect.height * ratio;
            
            const ctx = canvas.getContext('2d');
            ctx.scale(ratio, ratio);
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.lineWidth = 2;
            
            let isDrawing = false;
            let hasSignature = false;
            
            // Mouse events
            canvas.addEventListener('mousedown', (e) => {
                isDrawing = true;
                hasSignature = true;
                const rect = canvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                ctx.beginPath();
                ctx.moveTo(x, y);
            });
            
            canvas.addEventListener('mousemove', (e) => {
                if (!isDrawing) return;
                const rect = canvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                ctx.lineTo(x, y);
                ctx.stroke();
            });
            
            canvas.addEventListener('mouseup', () => {
                isDrawing = false;
            });
            
            canvas.addEventListener('mouseleave', () => {
                isDrawing = false;
            });
            
            // Touch events for mobile
            canvas.addEventListener('touchstart', (e) => {
                e.preventDefault();
                isDrawing = true;
                hasSignature = true;
                const rect = canvas.getBoundingClientRect();
                const touch = e.touches[0];
                const x = touch.clientX - rect.left;
                const y = touch.clientY - rect.top;
                ctx.beginPath();
                ctx.moveTo(x, y);
            });
            
            canvas.addEventListener('touchmove', (e) => {
                e.preventDefault();
                if (!isDrawing) return;
                const rect = canvas.getBoundingClientRect();
                const touch = e.touches[0];
                const x = touch.clientX - rect.left;
                const y = touch.clientY - rect.top;
                ctx.lineTo(x, y);
                ctx.stroke();
            });
            
            canvas.addEventListener('touchend', (e) => {
                e.preventDefault();
                isDrawing = false;
            });
            
            // Clear button
            clearBtn.addEventListener('click', (e) => {
                e.preventDefault();
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                signatureInput.value = '';
                hasSignature = false;
                signatureError.textContent = '';
            });
            
            // Form submission validation
            if (form) {
                form.addEventListener('submit', function(e) {
                    if (!latitudeInput.value || !longitudeInput.value) {
                        e.preventDefault();
                        mapError.textContent = 'Please select a location on the map';
                        return false;
                    }
                    mapError.textContent = '';
                    
                    // Validate signature
                    if (!hasSignature || !canvas.toDataURL().includes('data:image')) {
                        e.preventDefault();
                        signatureError.textContent = 'Please provide your signature';
                        return false;
                    }
                    
                    // Save signature to hidden input
                    signatureInput.value = canvas.toDataURL('image/png');
                    signatureError.textContent = '';
                });
            }
        }
    });
</script>

{% endblock %}
