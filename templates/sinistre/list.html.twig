{% extends 'base.html.twig' %}

{% block title %}{{ title }} - Credix{% endblock %}

{% block content %}
<div class="claims-container" style="margin-top: 150px;">
    <!-- Header Section -->
    <div class="claims-header">
        <div class="container-xxl">
            <div class="row align-items-center mb-4">
                <div class="col-lg-8">
                    <h1 class="display-4 fw-bold mb-2" style="color: #1a3a52;">
                        <i class="fa fa-file-medical me-3" style="color: #e74c3c;"></i>My Claims
                    </h1>
                    <p class="text-muted mb-0">Manage and track your insurance claims</p>
                </div>
                <div class="col-lg-4 text-end">
                    <a href="{{ path('app_sinistre_new') }}" class="btn btn-lg" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%); color: white; border: none; box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);">
                        <i class="fa fa-plus me-2"></i>File New Claim
                    </a>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon pending">
                            <i class="fa fa-hourglass-half"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Pending</h6>
                            <p class="stat-number">
                                {% set pending_count = sinistres|filter(s => s.statut == 'EN_ATTENTE')|length %}
                                {{ pending_count }}
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon accepted">
                            <i class="fa fa-check-circle"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Accepted</h6>
                            <p class="stat-number">
                                {% set accepted_count = sinistres|filter(s => s.statut == 'ACCEPTE')|length %}
                                {{ accepted_count }}
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon rejected">
                            <i class="fa fa-times-circle"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Rejected</h6>
                            <p class="stat-number">
                                {% set rejected_count = sinistres|filter(s => s.statut == 'REJETE')|length %}
                                {{ rejected_count }}
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon total">
                            <i class="fa fa-folder"></i>
                        </div>
                        <div class="stat-content">
                            <h6 class="text-muted small">Total</h6>
                            <p class="stat-number">{{ pagination.total|default(sinistres|length) }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-xxl py-5">
        <div class="container">
            <!-- Filter Section -->
            <div class="card filter-card mb-4 shadow-sm border-0">
                <div class="card-header" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border: none;">
                    <h5 class="mb-0" style="color: #1a3a52;">
                        <i class="fa fa-funnel me-2"></i>Filter Your Claims
                    </h5>
                </div>
                <div class="card-body">
                    <form method="GET" class="row g-3">
                        <div class="col-md-4">
                            <label for="search" class="form-label fw-600">Search</label>
                            <input type="text" class="form-control search-input" id="search" name="search" 
                                   placeholder="🔍 Claim ID or description" 
                                   value="{{ filters.search|default('') }}">
                        </div>

                        <div class="col-md-4">
                            <label for="status" class="form-label fw-600">Status</label>
                            <select class="form-select filter-select" id="status" name="status">
                                <option value="">All Statuses</option>
                                <option value="EN_ATTENTE" {% if filters.status == 'EN_ATTENTE' %}selected{% endif %}>Pending</option>
                                <option value="ACCEPTE" {% if filters.status == 'ACCEPTE' %}selected{% endif %}>Accepted</option>
                                <option value="REJETE" {% if filters.status == 'REJETE' %}selected{% endif %}>Rejected</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label for="date_from" class="form-label fw-600">Date Range</label>
                            <div class="input-group">
                                <input type="date" class="form-control filter-input" id="date_from" name="date_from" 
                                       value="{{ filters.date_from|default('') }}">
                                <input type="date" class="form-control filter-input" id="date_to" name="date_to" 
                                       value="{{ filters.date_to|default('') }}">
                            </div>
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary" style="background: #3498db; border: none;">
                                <i class="fa fa-search me-2"></i>Filter
                            </button>
                            <a href="{{ path('app_sinistre_list') }}" class="btn btn-outline-secondary">
                                <i class="fa fa-times me-2"></i>Clear Filters
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Claims List -->
            {% if pagination.total|default(sinistres|length) == 0 %}
                <div class="alert alert-info alert-custom" role="alert">
                    <div class="alert-icon">
                        <i class="fa fa-info-circle"></i>
                    </div>
                    <div class="alert-content">
                        <h5>No claims yet</h5>
                        <p>You haven't filed any claims. <a href="{{ path('app_sinistre_new') }}" class="alert-link">File your first claim</a></p>
                    </div>
                </div>
            {% else %}
                <div class="row g-4">
                    {% for sinistre in sinistres %}
                        <div class="col-lg-6 col-xl-4">
                            <div class="claim-card shadow-lg border-0">
                                <div class="claim-card-header">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="claim-id">
                                                <i class="fa fa-file-alt me-2"></i>Claim #{{ sinistre.id }}
                                            </h5>
                                        </div>
                                        {% if sinistre.statut == 'EN_ATTENTE' %}
                                            <span class="badge badge-lg bg-warning text-dark" style="font-size: 0.75rem;">Pending</span>
                                        {% elseif sinistre.statut == 'ACCEPTE' %}
                                            <span class="badge badge-lg bg-success" style="font-size: 0.75rem;">Accepted</span>
                                        {% elseif sinistre.statut == 'REJETE' %}
                                            <span class="badge badge-lg bg-danger" style="font-size: 0.75rem;">Rejected</span>
                                        {% elseif sinistre.statut == 'REMBOURSÉ' %}
                                            <span class="badge badge-lg bg-info" style="font-size: 0.75rem;">Reimbursed</span>
                                        {% else %}
                                            <span class="badge badge-lg bg-secondary" style="font-size: 0.75rem;">{{ sinistre.statut }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="claim-info-block">
                                        <div class="claim-info">
                                            <label class="claim-label">
                                                <i class="fa fa-file-contract"></i> Contract
                                            </label>
                                            <p class="claim-value">{{ sinistre.contrat.numeroContrat }}</p>
                                        </div>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="claim-info">
                                                <label class="claim-label">
                                                    <i class="fa fa-calendar"></i> Incident Date
                                                </label>
                                                <p class="claim-value">{{ sinistre.dateSinistre|date('d/m/Y') }}</p>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="claim-info">
                                                <label class="claim-label">
                                                    <i class="fa fa-clock"></i> Filed Date
                                                </label>
                                                <p class="claim-value small">{{ sinistre.createdAt|date('d/m/Y') }}</p>
                                            </div>
                                        </div>
                                    </div>
                                    {% if sinistre.description %}
                                        <div class="claim-info-block mt-2 pt-2 border-top">
                                            <label class="claim-label">
                                                <i class="fa fa-align-left"></i> Description
                                            </label>
                                            <p class="claim-description">{{ sinistre.description|slice(0, 100) }}{% if sinistre.description|length > 100 %}...{% endif %}</p>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="card-footer bg-white border-top">
                                    <div class="d-grid gap-2">
                                        <a href="{{ path('app_sinistre_show', {id: sinistre.id}) }}" class="btn btn-primary btn-sm">
                                            <i class="fa fa-eye me-1"></i>View Details
                                        </a>
                                    </div>
                                    {% if sinistre.statut == 'EN_ATTENTE' %}
                                        <div class="d-flex gap-2 mt-2">
                                            <a href="{{ path('app_sinistre_edit', {id: sinistre.id}) }}" class="btn btn-sm btn-outline-warning flex-grow-1" title="Edit">
                                                <i class="fa fa-edit me-1"></i>Edit
                                            </a>
                                            <form action="{{ path('app_sinistre_delete', {id: sinistre.id}) }}" method="POST" style="display: inline; flex-grow: 1;" 
                                                  onsubmit="return confirm('Are you sure you want to delete this claim?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger w-100" title="Delete">
                                                    <i class="fa fa-trash me-1"></i>Delete
                                                </button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Pagination -->
                {% if pagination.totalPages|default(1) > 1 %}
                <nav aria-label="Page navigation" class="mt-5">
                    <ul class="pagination justify-content-center pagination-custom">
                        {% if pagination.page > 1 %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_sinistre_list', app.request.query.all|merge({'page': 1})) }}">
                                    <i class="fa fa-chevron-left me-1"></i>First
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_sinistre_list', app.request.query.all|merge({'page': pagination.page - 1})) }}">Previous</a>
                            </li>
                        {% endif %}

                        {% for p in range(1, pagination.totalPages) %}
                            {% if p >= pagination.page - 2 and p <= pagination.page + 2 %}
                                <li class="page-item {% if p == pagination.page %}active{% endif %}">
                                    <a class="page-link" href="{{ path('app_sinistre_list', app.request.query.all|merge({'page': p})) }}">{{ p }}</a>
                                </li>
                            {% elseif p == pagination.page - 3 or p == pagination.page + 3 %}
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            {% endif %}
                        {% endfor %}

                        {% if pagination.page < pagination.totalPages %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_sinistre_list', app.request.query.all|merge({'page': pagination.page + 1})) }}">Next</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_sinistre_list', app.request.query.all|merge({'page': pagination.totalPages})) }}">
                                    Last <i class="fa fa-chevron-right ms-1"></i>
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                    <div class="text-center small text-muted mt-3">
                        Page {{ pagination.page }} of {{ pagination.totalPages }} 
                        ({{ sinistres|length }} of {{ pagination.total }} results)
                    </div>
                </nav>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>

<style>
    .claims-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
    }

    .claims-header {
        background: white;
        padding: 40px 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* Statistics Cards */
    .stat-card {
        display: flex;
        align-items: center;
        padding: 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        font-size: 24px;
    }

    .stat-icon.pending {
        background: #fff3cd;
        color: #ff9800;
    }

    .stat-icon.accepted {
        background: #d4edda;
        color: #28a745;
    }

    .stat-icon.rejected {
        background: #f8d7da;
        color: #dc3545;
    }

    .stat-icon.total {
        background: #d1ecf1;
        color: #17a2b8;
    }

    .stat-number {
        font-size: 28px;
        font-weight: bold;
        color: #1a3a52;
        margin: 0;
    }

    /* Filter Card */
    .filter-card {
        border-radius: 12px !important;
    }

    .search-input,
    .filter-select,
    .filter-input {
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        transition: all 0.3s ease;
    }

    .search-input:focus,
    .filter-select:focus,
    .filter-input:focus {
        border-color: #3498db;
        box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
    }

    /* Claim Cards */
    .claim-card {
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        background: white;
    }

    .claim-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15) !important;
    }

    .claim-card-header {
        background: linear-gradient(135deg, #1a3a52 0%, #2c5aa0 100%);
        color: white;
        padding: 20px;
    }

    .claim-id {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
        color: white;
    }

    .claim-label {
        font-size: 12px;
        font-weight: 600;
        color: #7f8fa3;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
    }

    .claim-value {
        font-size: 16px;
        font-weight: 500;
        color: #1a3a52;
        margin: 5px 0 0 0;
    }

    .claim-description {
        font-size: 14px;
        color: #555;
        margin: 5px 0 0 0;
        line-height: 1.4;
    }

    .claim-info-block {
        margin-bottom: 15px;
    }

    .badge-lg {
        padding: 0.5rem 0.75rem;
        font-weight: 600;
    }

    /* Alert Custom */
    .alert-custom {
        background: white;
        border: 2px solid #3498db;
        border-radius: 12px;
        padding: 30px;
        display: flex;
        align-items: center;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.15);
    }

    .alert-icon {
        font-size: 32px;
        color: #3498db;
        margin-right: 20px;
    }

    .alert-content h5 {
        color: #1a3a52;
        margin-bottom: 5px;
    }

    .alert-content p {
        margin: 0;
        color: #7f8fa3;
    }

    .alert-link {
        color: #e74c3c;
        font-weight: 600;
    }

    /* Pagination */
    .pagination-custom .page-link {
        border-radius: 6px;
        margin: 0 3px;
        color: #3498db;
        border: 1px solid #e0e0e0;
    }

    .pagination-custom .page-link:hover {
        background-color: #3498db;
        color: white;
        border-color: #3498db;
    }

    .pagination-custom .page-item.active .page-link {
        background-color: #3498db;
        border-color: #3498db;
    }

    /* Buttons */
    .btn-primary {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        border: none;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #2980b9 0%, #1f5a96 100%);
        box-shadow: 0 6px 16px rgba(52, 152, 219, 0.4);
    }

    .fw-600 {
        font-weight: 600;
    }
</style>

{% endblock %}
