{% extends 'base.html.twig' %}

{% block title %}{{ title }} - Credix{% endblock %}

{% block content %}
<div class="container-xxl py-5" style="margin-top: 150px; padding-top: 30px;">
    <div class="container">
        <div class="row mb-4">
            <div class="col-lg-8">
                <h1 class="display-5 mb-0">{{ title }}</h1>
            </div>
            <div class="col-lg-4 text-end">
                <a href="{{ path('app_sinistre_list') }}" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-2"></i>Back to Claims
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Claim #{{ sinistre.id }}</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Status:</strong><br>
                                {% if sinistre.statut == 'EN_ATTENTE' %}
                                    <span class="badge bg-warning text-dark">Pending</span>
                                {% elseif sinistre.statut == 'ACCEPTE' %}
                                    <span class="badge bg-success">Accepted</span>
                                {% elseif sinistre.statut == 'REJETE' %}
                                    <span class="badge bg-danger">Rejected</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ sinistre.statut }}</span>
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <strong>Filed on:</strong><br>
                                {{ sinistre.createdAt|date('d/m/Y H:i') }}
                            </div>
                        </div>

                        <hr>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Incident Date:</strong><br>
                                {{ sinistre.dateSinistre|date('d/m/Y') }}
                            </div>
                            <div class="col-md-6">
                                <strong>Contract Number:</strong><br>
                                {{ sinistre.contrat.numeroContrat }}
                            </div>
                        </div>

                        <div class="mb-3">
                            <strong>Associated Insurance:</strong><br>
                            {{ sinistre.contrat.assurance.nomAssurance ?? 'N/A' }} 
                            ({{ sinistre.contrat.assurance.typeAssurance ?? 'N/A' }})
                        </div>

                        <hr>

                        <div class="mb-3">
                            <strong>Claim Description:</strong><br>
                            <p class="text-muted" style="white-space: pre-wrap;">{{ sinistre.description }}</p>
                        </div>

                        {% if sinistre.preuves|length > 0 %}
                            <hr>
                            <div class="mb-3">
                                <strong>Evidence / Supporting Documents:</strong><br>
                                <div class="row mt-3">
                                    {% for preuve in sinistre.preuves %}
                                        <div class="col-md-6 mb-3">
                                            <div class="card">
                                                {% if preuve.typeFichier starts with 'image/' %}
                                                    <img src="{{ preuve.fichier }}" class="card-img-top" alt="{{ preuve.nomFichier }}" style="max-height: 200px; object-fit: cover;">
                                                {% else %}
                                                    <div class="card-body text-center bg-light">
                                                        <i class="fas fa-file" style="font-size: 2rem; color: #999;"></i>
                                                    </div>
                                                {% endif %}
                                                <div class="card-body">
                                                    <h6 class="card-title">{{ preuve.nomFichier }}</h6>
                                                    <p class="card-text text-muted"><small>{{ preuve.createdAt|date('d/m/Y H:i') }}</small></p>
                                                    <a href="{{ preuve.fichier }}" target="_blank" class="btn btn-sm btn-primary">
                                                        <i class="fas fa-download"></i> View
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        <!-- AI Damage Analysis Section -->
                        {{ include('sinistre/damage_analysis.html.twig') }}

                        {% if sinistre.statut != 'EN_ATTENTE' %}
                            <hr>
                            
                            <!-- Decision Notification -->
                            {% if sinistre.statut == 'ACCEPTE' %}
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <h5 class="alert-heading">
                                        <i class="fas fa-check-circle"></i> Claim Approved!
                                    </h5>
                                    <p>Your claim has been reviewed and <strong>approved</strong>.</p>
                                    <hr>
                                    {% if sinistre.adminReponse %}
                                        <p class="mb-0">
                                            <strong>Message from our team:</strong><br>
                                            <em>{{ sinistre.adminReponse }}</em>
                                        </p>
                                    {% else %}
                                        <p class="mb-0">Please contact us for further assistance.</p>
                                    {% endif %}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% elseif sinistre.statut == 'REJETE' %}
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <h5 class="alert-heading">
                                        <i class="fas fa-times-circle"></i> Claim Rejected
                                    </h5>
                                    <p>Your claim has been reviewed and <strong>rejected</strong>.</p>
                                    <hr>
                                    {% if sinistre.adminReponse %}
                                        <p class="mb-0">
                                            <strong>Reason:</strong><br>
                                            <em>{{ sinistre.adminReponse }}</em>
                                        </p>
                                    {% else %}
                                        <p class="mb-0">Please contact us if you have any questions.</p>
                                    {% endif %}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endif %}

                            {% if sinistre.dateReponse %}
                                <div class="mb-3">
                                    <small class="text-muted">Decision Date: {{ sinistre.dateReponse|date('d/m/Y H:i') }}</small>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                <!-- Edit/Delete Actions -->
                {% if sinistre.statut == 'EN_ATTENTE' %}
                    <div class="row gap-2 mb-4">
                        <div class="col-lg-6">
                            <a href="{{ path('app_sinistre_edit', {id: sinistre.id}) }}" class="btn btn-warning w-100">
                                <i class="fa fa-edit me-2"></i>Edit Claim
                            </a>
                        </div>
                        <div class="col-lg-6">
                            <form action="{{ path('app_sinistre_delete', {id: sinistre.id}) }}" method="POST" 
                                  onsubmit="return confirm('Are you sure you want to delete this claim?');">
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="fa fa-trash me-2"></i>Delete Claim
                                </button>
                            </form>
                        </div>
                    </div>
                {% endif %}
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="card wow fadeInUp" data-wow-delay="0.3s">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Claim Information</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-6">Claim ID:</dt>
                            <dd class="col-sm-6">
                                <strong>#{{ sinistre.id }}</strong>
                            </dd>

                            <dt class="col-sm-6">Status:</dt>
                            <dd class="col-sm-6">
                                {% if sinistre.statut == 'EN_ATTENTE' %}
                                    <span class="badge bg-warning text-dark">Pending</span>
                                {% elseif sinistre.statut == 'ACCEPTE' %}
                                    <span class="badge bg-success">Accepted</span>
                                {% elseif sinistre.statut == 'REJETE' %}
                                    <span class="badge bg-danger">Rejected</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ sinistre.statut }}</span>
                                {% endif %}
                            </dd>

                            <dt class="col-sm-6">Contract:</dt>
                            <dd class="col-sm-6">
                                <a href="{{ path('app_contract_show', {id: sinistre.contrat.id}) }}">
                                    {{ sinistre.contrat.numeroContrat }}
                                </a>
                            </dd>

                            <dt class="col-sm-6">User:</dt>
                            <dd class="col-sm-6">
                                {{ sinistre.utilisateur.nom }} {{ sinistre.utilisateur.prenom }}
                            </dd>
                        </dl>

                        <hr>

                        <p class="text-muted mb-0">
                            <small>
                                Created: {{ sinistre.createdAt|date('d/m/Y H:i') }}<br>
                                {% if sinistre.statut != 'EN_ATTENTE' %}
                                    Responded: {% if sinistre.dateReponse %}{{ sinistre.dateReponse|date('d/m/Y H:i') }}{% else %}Pending{% endif %}
                                {% endif %}
                            </small>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
